{
  "mushaf_id": 4,
  "mushaf_name": "مصحف ورش",
  "hizb": 37,
  "surahs": [
    {
      "id": 25,
      "name": "سورة الفرقان",
      "coded_name": "ﮥ",
      "ayahs": [
        {
          "id": 21579,
          "number": 21,
          "surah": "25",
          "page_number": 362,
          "text": "۞وَقَالَ اَ۬لذِينَ لَا يَرْجُونَ لِقَآءَنَا لَوْلَآ أُنزِلَ عَلَيْنَا اَ۬لْمَلَٰٓئِكَةُ أَوْ نَر۪يٰ رَبَّنَاۖ لَقَدِ اِ۪سْتَكْبَرُواْ فِےٓ أَنفُسِهِمْ وَعَتَوْ عُتُوّاٗ كَبِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21580,
          "number": 22,
          "surah": "25",
          "page_number": 362,
          "text": "يَوْمَ يَرَوْنَ اَ۬لْمَلَٰٓئِكَةَ لَا بُشْر۪يٰ يَوْمَئِذٖ لِّلْمُجْرِمِينَ وَيَقُولُونَ حِجْراٗ مَّحْجُوراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21581,
          "number": 23,
          "surah": "25",
          "page_number": 362,
          "text": "وَقَدِمْنَآ إِلَيٰ مَا عَمِلُواْ مِنْ عَمَلٖ فَجَعَلْنَٰهُ هَبَآءٗ مَّنثُوراًۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21582,
          "number": 24,
          "surah": "25",
          "page_number": 362,
          "text": "اَصْحَٰبُ اُ۬لْجَنَّةِ يَوْمَئِذٍ خَيْرٞ مُّسْتَقَرّاٗ وَأَحْسَنُ مَقِيلاٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21583,
          "number": 25,
          "surah": "25",
          "page_number": 362,
          "text": "وَيَوْمَ تَشَّقَّقُ اُ۬لسَّمَآءُ بِالْغَمَٰمِ وَنُزِّلَ اَ۬لْمَلَٰٓئِكَةُ تَنزِيلاًۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21584,
          "number": 26,
          "surah": "25",
          "page_number": 362,
          "text": "اِ۬لْمُلْكُ يَوْمَئِذٍ اِ۬لْحَقُّ لِلرَّحْمَٰنِۖ وَكَانَ يَوْماً عَلَي اَ۬لْكٰ۪فِرِينَ عَسِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21585,
          "number": 27,
          "surah": "25",
          "page_number": 362,
          "text": "وَيَوْمَ يَعَضُّ اُ۬لظَّالِمُ عَلَيٰ يَدَيْهِ يَقُولُ يَٰلَيْتَنِے اِ۪تَّخَذتُّ مَعَ اَ۬لرَّسُولِ سَبِيلاٗ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21586,
          "number": 28,
          "surah": "25",
          "page_number": 362,
          "text": "يَٰوَيْلَت۪يٰ لَيْتَنِے لَمَ اَتَّخِذْ فُلَٰناً خَلِيلاٗ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21587,
          "number": 29,
          "surah": "25",
          "page_number": 362,
          "text": "لَّقَدَ اَضَلَّنِے عَنِ اِ۬لذِّكْرِ بَعْدَ إِذْ جَآءَنِےۖ وَكَانَ اَ۬لشَّيْطَٰنُ لِلِانسَٰنِ خَذُولاٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21588,
          "number": 30,
          "surah": "25",
          "page_number": 362,
          "text": "وَقَالَ اَ۬لرَّسُولُ يَٰرَبِّ إِنَّ قَوْمِيَ اَ۪تَّخَذُواْ هَٰذَا اَ۬لْقُرْءَانَ مَهْجُوراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21589,
          "number": 31,
          "surah": "25",
          "page_number": 362,
          "text": "وَكَذَٰلِكَ جَعَلْنَا لِكُلِّ نَبِےٓءٍ عَدُوّاٗ مِّنَ اَ۬لْمُجْرِمِينَۖ وَكَف۪يٰ بِرَبِّكَ هَادِياٗ وَنَصِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21590,
          "number": 32,
          "surah": "25",
          "page_number": 362,
          "text": "وَقَالَ اَ۬لذِينَ كَفَرُواْ لَوْلَا نُزِّلَ عَلَيْهِ اِ۬لْقُرْءَانُ جُمْلَةٗ وَٰحِدَةٗۖ كَذَٰلِكَ لِنُثَبِّتَ بِهِۦ فُؤَادَكَۖ وَرَتَّلْنَٰهُ تَرْتِيلاٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21591,
          "number": 33,
          "surah": "25",
          "page_number": 363,
          "text": "وَلَا يَاتُونَكَ بِمَثَلٍ اِلَّا جِيـْٔنَٰكَ بِالْحَقِّ وَأَحْسَنَ تَفْسِيراًۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21592,
          "number": 34,
          "surah": "25",
          "page_number": 363,
          "text": "اِ۬لذِينَ يُحْشَرُونَ عَلَيٰ وُجُوهِهِمُۥٓ إِلَيٰ جَهَنَّمَ أُوْلَٰٓئِكَ شَرّٞ مَّكَاناٗ وَأَضَلُّ سَبِيلاٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21593,
          "number": 35,
          "surah": "25",
          "page_number": 363,
          "text": "۞وَلَقَدَ اٰتَيْنَا مُوسَي اَ۬لْكِتَٰبَ وَجَعَلْنَا مَعَهُۥٓ أَخَاهُ هَٰرُونَ وَزِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21594,
          "number": 36,
          "surah": "25",
          "page_number": 363,
          "text": "فَقُلْنَا اَ۪ذْهَبَآ إِلَي اَ۬لْقَوْمِ اِ۬لذِينَ كَذَّبُواْ بِــَٔايَٰتِنَاۖ فَدَمَّرْنَٰهُمْ تَدْمِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21595,
          "number": 37,
          "surah": "25",
          "page_number": 363,
          "text": "وَقَوْمَ نُوحٖ لَّمَّا كَذَّبُواْ اُ۬لرُّسُلَ أَغْرَقْنَٰهُمْ وَجَعَلْنَٰهُمْ لِلنَّاسِ ءَايَةٗۖ وَأَعْتَدْنَا لِلظَّٰلِمِينَ عَذَاباً اَلِيماٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21596,
          "number": 38,
          "surah": "25",
          "page_number": 363,
          "text": "وَعَاداٗ وَثَمُوداٗ وَأَصْحَٰبَ اَ۬لرَّسِّ وَقُرُوناَۢ بَيْنَ ذَٰلِكَ كَثِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21597,
          "number": 39,
          "surah": "25",
          "page_number": 363,
          "text": "وَكُلّاٗ ضَرَبْنَا لَهُ اُ۬لَامْثَٰلَۖ وَكُلّاٗ تَبَّرْنَا تَتْبِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21598,
          "number": 40,
          "surah": "25",
          "page_number": 363,
          "text": "وَلَقَدَ اَتَوْاْ عَلَي اَ۬لْقَرْيَةِ اِ۬لتِےٓ أُمْطِرَتْ مَطَرَ اَ۬لسَّوْءِۖ اَ۬فَلَمْ يَكُونُواْ يَرَوْنَهَاۖ بَلْ كَانُواْ لَا يَرْجُونَ نُشُوراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21599,
          "number": 41,
          "surah": "25",
          "page_number": 363,
          "text": "وَإِذَا رَأَوْكَ إِنْ يَّتَّخِذُونَكَ إِلَّا هُزُؤاً اَهَٰذَا اَ۬لذِے بَعَثَ اَ۬للَّهُ رَسُولاً",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21600,
          "number": 42,
          "surah": "25",
          "page_number": 363,
          "text": "اِن كَادَ لَيُضِلُّنَا عَنَ اٰلِهَتِنَا لَوْلَآ أَن صَبَرْنَا عَلَيْهَاۖ وَسَوْفَ يَعْلَمُونَ حِينَ يَرَوْنَ اَ۬لْعَذَابَ مَنَ اَضَلُّ سَبِيلاًۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21601,
          "number": 43,
          "surah": "25",
          "page_number": 363,
          "text": "اَرَٰٓيْتَ مَنِ اِ۪تَّخَذَ إِلَٰهَهُۥ هَو۪يٰهُ أَفَأَنتَ تَكُونُ عَلَيْهِ وَكِيلاًۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21602,
          "number": 44,
          "surah": "25",
          "page_number": 364,
          "text": "اَمْ تَحْسِبُ أَنَّ أَكْثَرَهُمْ يَسْمَعُونَ أَوْ يَعْقِلُونَۖ إِنْ هُمُۥٓ إِلَّا كَالَانْعَٰمِ بَلْ هُمُۥٓ أَضَلُّ سَبِيلاًۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21603,
          "number": 45,
          "surah": "25",
          "page_number": 364,
          "text": "۞اَلَمْ تَرَ إِلَيٰ رَبِّكَ كَيْفَ مَدَّ اَ۬لظِّلَّ وَلَوْ شَآءَ لَجَعَلَهُۥ سَاكِناٗ ثُمَّ جَعَلْنَا اَ۬لشَّمْسَ عَلَيْهِ دَلِيلاٗ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21604,
          "number": 46,
          "surah": "25",
          "page_number": 364,
          "text": "ثُمَّ قَبَضْنَٰهُ إِلَيْنَا قَبْضاٗ يَسِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21605,
          "number": 47,
          "surah": "25",
          "page_number": 364,
          "text": "وَهُوَ اَ۬لذِے جَعَلَ لَكُمُ اُ۬ليْلَ لِبَاساٗ وَالنَّوْمَ سُبَاتاٗ وَجَعَلَ اَ۬لنَّهَارَ نُشُوراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21606,
          "number": 48,
          "surah": "25",
          "page_number": 364,
          "text": "وَهُوَ اَ۬لذِےٓ أَرْسَلَ اَ۬لرِّيَٰحَ نُشُراَۢ بَيْنَ يَدَےْ رَحْمَتِهِۦۖ وَأَنزَلْنَا مِنَ اَ۬لسَّمَآءِ مَآءٗ طَهُوراٗ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21607,
          "number": 49,
          "surah": "25",
          "page_number": 364,
          "text": "لِّنُحْـِۧيَ بِهِۦ بَلْدَةٗ مَّيْتاٗ وَنُسْقِيَهُۥ مِمَّا خَلَقْنَآ أَنْعَٰماٗ وَأَنَاسِيَّ كَثِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21608,
          "number": 50,
          "surah": "25",
          "page_number": 364,
          "text": "وَلَقَدْ صَرَّفْنَٰهُ بَيْنَهُمْ لِيَذَّكَّرُواْ فَأَب۪يٰٓ أَكْثَرُ اُ۬لنَّاسِ إِلَّا كُفُوراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21609,
          "number": 51,
          "surah": "25",
          "page_number": 364,
          "text": "وَلَوْ شِيـْٔنَا لَبَعَثْنَا فِے كُلِّ قَرْيَةٖ نَّذِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21610,
          "number": 52,
          "surah": "25",
          "page_number": 364,
          "text": "فَلَا تُطِعِ اِ۬لْكٰ۪فِرِينَ وَجَٰهِدْهُم بِهِۦ جِهَاداٗ كَبِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21611,
          "number": 53,
          "surah": "25",
          "page_number": 364,
          "text": "وَهُوَ اَ۬لذِے مَرَجَ اَ۬لْبَحْرَيْنِ هَٰذَا عَذْبٞ فُرَاتٞ وَهَٰذَا مِلْحٌ ا۟جَاجٞ وَجَعَلَ بَيْنَهُمَا بَرْزَخاٗ وَحِجْراٗ مَّحْجُوراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21612,
          "number": 54,
          "surah": "25",
          "page_number": 364,
          "text": "وَهُوَ اَ۬لذِے خَلَقَ مِنَ اَ۬لْمَآءِ بَشَراٗ فَجَعَلَهُۥ نَسَباٗ وَصِهْراٗۖ وَكَانَ رَبُّكَ قَدِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21613,
          "number": 55,
          "surah": "25",
          "page_number": 364,
          "text": "وَيَعْبُدُونَ مِن دُونِ اِ۬للَّهِ مَا لَا يَنفَعُهُمْ وَلَا يَضُرُّهُمْۖ وَكَانَ اَ۬لْكَافِرُ عَلَيٰ رَبِّهِۦ ظَهِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21614,
          "number": 56,
          "surah": "25",
          "page_number": 365,
          "text": "وَمَآ أَرْسَلْنَٰكَ إِلَّا مُبَشِّراٗ وَنَذِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21615,
          "number": 57,
          "surah": "25",
          "page_number": 365,
          "text": "قُلْ مَآ أَسْــَٔلُكُمْ عَلَيْهِ مِنَ اَجْرٍ اِلَّا مَن شَآءَ انْ يَّتَّخِذَ إِلَيٰ رَبِّهِۦ سَبِيلاٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21616,
          "number": 58,
          "surah": "25",
          "page_number": 365,
          "text": "وَتَوَكَّلْ عَلَي اَ۬لْحَيِّ اِ۬لذِے لَا يَمُوتُ وَسَبِّحْ بِحَمْدِهِۦۖ وَكَف۪يٰ بِهِۦ بِذُنُوبِ عِبَادِهِۦ خَبِيراًۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21617,
          "number": 59,
          "surah": "25",
          "page_number": 365,
          "text": "اِ۬لذِے خَلَقَ اَ۬لسَّمَٰوَٰتِ وَالَارْضَ وَمَا بَيْنَهُمَا فِے سِتَّةِ أَيَّامٖ ثُمَّ اَ۪سْتَو۪يٰ عَلَي اَ۬لْعَرْشِۖ اِ۬لرَّحْمَٰنُ فَسْــَٔلْ بِهِۦ خَبِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21618,
          "number": 60,
          "surah": "25",
          "page_number": 365,
          "text": "وَإِذَا قِيلَ لَهُمُ اُ۟سْجُدُواْ لِلرَّحْمَٰنِ قَالُواْ وَمَا اَ۬لرَّحْمَٰنُ أَنَسْجُدُ لِمَا تَامُرُنَا وَزَادَهُمْ نُفُوراٗۖ۩",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21619,
          "number": 61,
          "surah": "25",
          "page_number": 365,
          "text": "۞تَبَٰرَكَ اَ۬لذِے جَعَلَ فِے اِ۬لسَّمَآءِ بُرُوجاٗ وَجَعَلَ فِيهَا سِرَٰجاٗ وَقَمَراٗ مُّنِيراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21620,
          "number": 62,
          "surah": "25",
          "page_number": 365,
          "text": "وَهُوَ اَ۬لذِے جَعَلَ اَ۬ليْلَ وَالنَّهَارَ خِلْفَةٗ لِّمَنَ اَرَادَ أَنْ يَّذَّكَّرَ أَوَ اَرَادَ شُكُوراٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21621,
          "number": 63,
          "surah": "25",
          "page_number": 365,
          "text": "وَعِبَادُ اُ۬لرَّحْمَٰنِ اِ۬لذِينَ يَمْشُونَ عَلَي اَ۬لَارْضِ هَوْناٗ وَإِذَا خَاطَبَهُمُ اُ۬لْجَٰهِلُونَ قَالُواْ سَلَٰماٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21622,
          "number": 64,
          "surah": "25",
          "page_number": 365,
          "text": "وَالذِينَ يَبِيتُونَ لِرَبِّهِمْ سُجَّداٗ وَقِيَٰماٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21623,
          "number": 65,
          "surah": "25",
          "page_number": 365,
          "text": "وَالذِينَ يَقُولُونَ رَبَّنَا اَ۪صْرِفْ عَنَّا عَذَابَ جَهَنَّمَ إِنَّ عَذَابَهَا كَانَ غَرَاماًۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21624,
          "number": 66,
          "surah": "25",
          "page_number": 365,
          "text": "اِنَّهَا سَآءَتْ مُسْتَقَرّاٗ وَمُقَاماٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21625,
          "number": 67,
          "surah": "25",
          "page_number": 365,
          "text": "وَالذِينَ إِذَآ أَنفَقُواْ لَمْ يُسْرِفُواْ وَلَمْ يُقْتِرُواْ وَكَانَ بَيْنَ ذَٰلِكَ قَوَاماٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21626,
          "number": 68,
          "surah": "25",
          "page_number": 366,
          "text": "وَالذِينَ لَا يَدْعُونَ مَعَ اَ۬للَّهِ إِلَٰهاً اٰخَرَ وَلَا يَقْتُلُونَ اَ۬لنَّفْسَ اَ۬لتِے حَرَّمَ اَ۬للَّهُ إِلَّا بِالْحَقِّ وَلَا يَزْنُونَۖ وَمَنْ يَّفْعَلْ ذَٰلِكَ يَلْقَ أَثَاماٗ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21627,
          "number": 69,
          "surah": "25",
          "page_number": 366,
          "text": "يُضَٰعَفْ لَهُ اُ۬لْعَذَابُ يَوْمَ اَ۬لْقِيَٰمَةِ وَيَخْلُدْ فِيهِ مُهَاناً",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21628,
          "number": 70,
          "surah": "25",
          "page_number": 366,
          "text": "اِلَّا مَن تَابَ وَءَامَنَ وَعَمِلَ عَمَلاٗ صَٰلِحاٗ فَأُوْلَٰٓئِكَ يُبَدِّلُ اُ۬للَّهُ سَيِّــَٔاتِهِمْ حَسَنَٰتٖۖ وَكَانَ اَ۬للَّهُ غَفُوراٗ رَّحِيماٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21629,
          "number": 71,
          "surah": "25",
          "page_number": 366,
          "text": "وَمَن تَابَ وَعَمِلَ صَٰلِحاٗ فَإِنَّهُۥ يَتُوبُ إِلَي اَ۬للَّهِ مَتَاباٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21630,
          "number": 72,
          "surah": "25",
          "page_number": 366,
          "text": "وَالذِينَ لَا يَشْهَدُونَ اَ۬لزُّورَ وَإِذَا مَرُّواْ بِاللَّغْوِ مَرُّواْ كِرَاماٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21631,
          "number": 73,
          "surah": "25",
          "page_number": 366,
          "text": "وَالذِينَ إِذَا ذُكِّرُواْ بِــَٔايَٰتِ رَبِّهِمْ لَمْ يَخِرُّواْ عَلَيْهَا صُمّاٗ وَعُمْيَاناٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21632,
          "number": 74,
          "surah": "25",
          "page_number": 366,
          "text": "وَالذِينَ يَقُولُونَ رَبَّنَا هَبْ لَنَا مِنَ اَزْوَٰجِنَا وَذُرِّيَّٰتِنَا قُرَّةَ أَعْيُنٖ وَاجْعَلْنَا لِلْمُتَّقِينَ إِمَاماًۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21633,
          "number": 75,
          "surah": "25",
          "page_number": 366,
          "text": "ا۟وْلَٰٓئِكَ يُجْزَوْنَ اَ۬لْغُرْفَةَ بِمَا صَبَرُواْ وَيُلَقَّوْنَ فِيهَا تَحِيَّةٗ وَسَلَٰماً",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21634,
          "number": 76,
          "surah": "25",
          "page_number": 366,
          "text": "خَٰلِدِينَ فِيهَاۖ حَسُنَتْ مُسْتَقَرّاٗ وَمُقَاماٗۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21635,
          "number": 77,
          "surah": "25",
          "page_number": 366,
          "text": "قُلْ مَا يَعْبَؤُاْ بِكُمْ رَبِّے لَوْلَا دُعَآؤُكُمْۖ فَقَدْ كَذَّبْتُمْ فَسَوْفَ يَكُونُ لِزَاماٗۖ",
          "juz": 19,
          "hizb": 37
        }
      ]
    },
    {
      "id": 26,
      "name": "سورة الشعراء",
      "coded_name": "ﮦ",
      "ayahs": [
        {
          "id": 21636,
          "number": 1,
          "surah": "26",
          "page_number": 367,
          "text": "طَسِٓمِّٓۖ تِلْكَ ءَايَٰتُ اُ۬لْكِتَٰبِ اِ۬لْمُبِينِۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21637,
          "number": 2,
          "surah": "26",
          "page_number": 367,
          "text": "لَعَلَّكَ بَٰخِعٞ نَّفْسَكَ أَلَّا يَكُونُواْ مُومِنِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21638,
          "number": 3,
          "surah": "26",
          "page_number": 367,
          "text": "إِن نَّشَأْ نُنَزِّلْ عَلَيْهِم مِّنَ اَ۬لسَّمَآءِ اَ۟يَةٗ فَظَلَّتَ اَعْنَٰقُهُمْ لَهَا خَٰضِعِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21639,
          "number": 4,
          "surah": "26",
          "page_number": 367,
          "text": "وَمَا يَاتِيهِم مِّن ذِكْرٖ مِّنَ اَ۬لرَّحْمَٰنِ مُحْدَثٍ اِلَّا كَانُواْ عَنْهُ مُعْرِضِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21640,
          "number": 5,
          "surah": "26",
          "page_number": 367,
          "text": "فَقَدْ كَذَّبُواْ فَسَيَاتِيهِمُۥٓ أَنۢبَٰٓؤُاْ مَا كَانُواْ بِهِۦ يَسْتَهْزِءُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21641,
          "number": 6,
          "surah": "26",
          "page_number": 367,
          "text": "أَوَلَمْ يَرَوِاْ اِلَي اَ۬لَارْضِ كَمَ اَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٖ كَرِيمٍۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21642,
          "number": 7,
          "surah": "26",
          "page_number": 367,
          "text": "اِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّومِنِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21643,
          "number": 8,
          "surah": "26",
          "page_number": 367,
          "text": "وَإِنَّ رَبَّكَ لَهُوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21644,
          "number": 9,
          "surah": "26",
          "page_number": 367,
          "text": "وَإِذْ نَاد۪يٰ رَبُّكَ مُوس۪يٰٓ أَنِ اِ۪يتِ اِ۬لْقَوْمَ اَ۬لظَّٰلِمِينَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21645,
          "number": 10,
          "surah": "26",
          "page_number": 367,
          "text": "قَوْمَ فِرْعَوْنَۖ أَلَا يَتَّقُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21646,
          "number": 11,
          "surah": "26",
          "page_number": 367,
          "text": "قَالَ رَبِّ إِنِّيَ أَخَافُ أَنْ يُّكَذِّبُونِ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21647,
          "number": 12,
          "surah": "26",
          "page_number": 367,
          "text": "وَيَضِيقُ صَدْرِے وَلَا يَنطَلِقُ لِسَانِے فَأَرْسِلِ اِلَيٰ هَٰرُونَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21648,
          "number": 13,
          "surah": "26",
          "page_number": 367,
          "text": "وَلَهُمْ عَلَيَّ ذَنۢبٞ فَأَخَافُ أَنْ يَّقْتُلُونِۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21649,
          "number": 14,
          "surah": "26",
          "page_number": 367,
          "text": "قَالَ كَلَّاۖ فَاذْهَبَا بِــَٔايَٰتِنَآۖ إِنَّا مَعَكُم مُّسْتَمِعُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21650,
          "number": 15,
          "surah": "26",
          "page_number": 367,
          "text": "فَاتِيَا فِرْعَوْنَ فَقُولَآ إِنَّا رَسُولُ رَبِّ اِ۬لْعَٰلَمِينَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21651,
          "number": 16,
          "surah": "26",
          "page_number": 367,
          "text": "أَنَ اَرْسِلْ مَعَنَا بَنِےٓ إِسْرَآءِيلَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21652,
          "number": 17,
          "surah": "26",
          "page_number": 367,
          "text": "قَالَ أَلَمْ نُرَبِّكَ فِينَا وَلِيداٗ وَلَبِثْتَ فِينَا مِنْ عُمُرِكَ سِنِينَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21653,
          "number": 18,
          "surah": "26",
          "page_number": 367,
          "text": "وَفَعَلْتَ فَعْلَتَكَ اَ۬لتِے فَعَلْتَ وَأَنتَ مِنَ اَ۬لْكٰ۪فِرِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21654,
          "number": 19,
          "surah": "26",
          "page_number": 368,
          "text": "قَالَ فَعَلْتُهَآ إِذاٗ وَأَنَا مِنَ اَ۬لضَّآلِّينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21655,
          "number": 20,
          "surah": "26",
          "page_number": 368,
          "text": "فَفَرَرْتُ مِنكُمْ لَمَّا خِفْتُكُمْ فَوَهَبَ لِے رَبِّے حُكْماٗ وَجَعَلَنِے مِنَ اَ۬لْمُرْسَلِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21656,
          "number": 21,
          "surah": "26",
          "page_number": 368,
          "text": "وَتِلْكَ نِعْمَةٞ تَمُنُّهَا عَلَيَّ أَنْ عَبَّدتَّ بَنِےٓ إِسْرَآءِيلَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21657,
          "number": 22,
          "surah": "26",
          "page_number": 368,
          "text": "قَالَ فِرْعَوْنُ وَمَا رَبُّ اُ۬لْعَٰلَمِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21658,
          "number": 23,
          "surah": "26",
          "page_number": 368,
          "text": "قَالَ رَبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَآ إِن كُنتُم مُّوقِنِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21659,
          "number": 24,
          "surah": "26",
          "page_number": 368,
          "text": "۞قَالَ لِمَنْ حَوْلَهُۥٓ أَلَا تَسْتَمِعُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21660,
          "number": 25,
          "surah": "26",
          "page_number": 368,
          "text": "قَالَ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ اُ۬لَاوَّلِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21661,
          "number": 26,
          "surah": "26",
          "page_number": 368,
          "text": "قَالَ إِنَّ رَسُولَكُمُ اُ۬لذِےٓ أُرْسِلَ إِلَيْكُمْ لَمَجْنُونٞۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21662,
          "number": 27,
          "surah": "26",
          "page_number": 368,
          "text": "قَالَ رَبُّ اُ۬لْمَشْرِقِ وَالْمَغْرِبِ وَمَا بَيْنَهُمَآ إِن كُنتُمْ تَعْقِلُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21663,
          "number": 28,
          "surah": "26",
          "page_number": 368,
          "text": "قَالَ لَئِنِ اِ۪تَّخَذتَّ إِلَٰهاً غَيْرِے لَأَجْعَلَنَّكَ مِنَ اَ۬لْمَسْجُونِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21664,
          "number": 29,
          "surah": "26",
          "page_number": 368,
          "text": "قَالَ أَوَلَوْ جِيـْٔتُكَ بِشَےْءٖ مُّبِينٖۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21665,
          "number": 30,
          "surah": "26",
          "page_number": 368,
          "text": "قَالَ فَاتِ بِهِۦٓ إِن كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21666,
          "number": 31,
          "surah": "26",
          "page_number": 368,
          "text": "فَأَلْق۪يٰ عَصَاهُ فَإِذَا هِيَ ثُعْبَانٞ مُّبِينٞۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21667,
          "number": 32,
          "surah": "26",
          "page_number": 368,
          "text": "وَنَزَعَ يَدَهُۥ فَإِذَا هِيَ بَيْضَآءُ لِلنَّٰظِرِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21668,
          "number": 33,
          "surah": "26",
          "page_number": 368,
          "text": "قَالَ لِلْمَلَإِ حَوْلَهُۥٓ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمٞ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21669,
          "number": 34,
          "surah": "26",
          "page_number": 368,
          "text": "يُرِيدُ أَنْ يُّخْرِجَكُم مِّنَ اَرْضِكُم بِسِحْرِهِۦ فَمَاذَا تَامُرُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21670,
          "number": 35,
          "surah": "26",
          "page_number": 368,
          "text": "قَالُوٓاْ أَرْجِهِۦ وَأَخَاهُ وَابْعَثْ فِے اِ۬لْمَدَآئِنِ حَٰشِرِينَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21671,
          "number": 36,
          "surah": "26",
          "page_number": 368,
          "text": "يَاتُوكَ بِكُلِّ سَحّ۪ارٍ عَلِيمٖۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21672,
          "number": 37,
          "surah": "26",
          "page_number": 368,
          "text": "فَجُمِعَ اَ۬لسَّحَرَةُ لِمِيقَٰتِ يَوْمٖ مَّعْلُومٖۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21673,
          "number": 38,
          "surah": "26",
          "page_number": 368,
          "text": "وَقِيلَ لِلنَّاسِ هَلَ اَنتُم مُّجْتَمِعُونَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21674,
          "number": 39,
          "surah": "26",
          "page_number": 369,
          "text": "لَعَلَّنَا نَتَّبِعُ اُ۬لسَّحَرَةَ إِن كَانُواْ هُمُ اُ۬لْغَٰلِبِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21675,
          "number": 40,
          "surah": "26",
          "page_number": 369,
          "text": "فَلَمَّا جَآءَ اَ۬لسَّحَرَةُ قَالُواْ لِفِرْعَوْنَ أَئِنَّ لَنَا لَأَجْراً اِن كُنَّا نَحْنُ اُ۬لْغَٰلِبِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21676,
          "number": 41,
          "surah": "26",
          "page_number": 369,
          "text": "قَالَ نَعَمْ وَإِنَّكُمُۥٓ إِذاٗ لَّمِنَ اَ۬لْمُقَرَّبِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21677,
          "number": 42,
          "surah": "26",
          "page_number": 369,
          "text": "قَالَ لَهُم مُّوس۪يٰٓ أَلْقُواْ مَآ أَنتُم مُّلْقُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21678,
          "number": 43,
          "surah": "26",
          "page_number": 369,
          "text": "فَأَلْقَوْاْ حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُواْ بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ اُ۬لْغَٰلِبُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21679,
          "number": 44,
          "surah": "26",
          "page_number": 369,
          "text": "فَأَلْق۪يٰ مُوس۪يٰ عَصَاهُ فَإِذَا هِيَ تَلَقَّفُ مَا يَافِكُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21680,
          "number": 45,
          "surah": "26",
          "page_number": 369,
          "text": "فَأُلْقِيَ اَ۬لسَّحَرَةُ سَٰجِدِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21681,
          "number": 46,
          "surah": "26",
          "page_number": 369,
          "text": "قَالُوٓاْ ءَامَنَّا بِرَبِّ اِ۬لْعَٰلَمِينَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21682,
          "number": 47,
          "surah": "26",
          "page_number": 369,
          "text": "رَبِّ مُوس۪يٰ وَهَٰرُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21683,
          "number": 48,
          "surah": "26",
          "page_number": 369,
          "text": "قَالَ ءَاٰ۬مَنتُمْ لَهُۥ قَبْلَ أَنَ اٰذَنَ لَكُمُۥٓ إِنَّهُۥ لَكَبِيرُكُمُ اُ۬لذِے عَلَّمَكُمُ اُ۬لسِّحْرَ فَلَسَوْفَ تَعْلَمُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21684,
          "number": 49,
          "surah": "26",
          "page_number": 369,
          "text": "لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ خِلَٰفٖ وَلَأُصَلِّبَنَّكُمُۥٓ أَجْمَعِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21685,
          "number": 50,
          "surah": "26",
          "page_number": 369,
          "text": "۞قَالُواْ لَا ضَيْرَۖ إِنَّآ إِلَيٰ رَبِّنَا مُنقَلِبُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21686,
          "number": 51,
          "surah": "26",
          "page_number": 369,
          "text": "إِنَّا نَطْمَعُ أَنْ يَّغْفِرَ لَنَا رَبُّنَا خَطَٰيٰ۪نَآ أَن كُنَّآ أَوَّلَ اَ۬لْمُومِنِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21687,
          "number": 52,
          "surah": "26",
          "page_number": 369,
          "text": "وَأَوْحَيْنَآ إِلَيٰ مُوس۪يٰٓ أَنِ اِ۪سْرِ بِعِبَادِيَ إِنَّكُم مُّتَّبَعُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21688,
          "number": 53,
          "surah": "26",
          "page_number": 369,
          "text": "فَأَرْسَلَ فِرْعَوْنُ فِے اِ۬لْمَدَآئِنِ حَٰشِرِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21689,
          "number": 54,
          "surah": "26",
          "page_number": 369,
          "text": "إِنَّ هَٰٓؤُلَآءِ لَشِرْذِمَةٞ قَلِيلُونَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21690,
          "number": 55,
          "surah": "26",
          "page_number": 369,
          "text": "وَإِنَّهُمْ لَنَا لَغَآئِظُونَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21691,
          "number": 56,
          "surah": "26",
          "page_number": 369,
          "text": "وَإِنَّا لَجَمِيعٌ حَذِرُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21692,
          "number": 57,
          "surah": "26",
          "page_number": 369,
          "text": "فَأَخْرَجْنَٰهُم مِّن جَنَّٰتٖ وَعُيُونٖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21693,
          "number": 58,
          "surah": "26",
          "page_number": 369,
          "text": "وَكُنُوزٖ وَمَقَامٖ كَرِيمٖۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21694,
          "number": 59,
          "surah": "26",
          "page_number": 369,
          "text": "كَذَٰلِكَۖ وَأَوْرَثْنَٰهَا بَنِےٓ إِسْرَآءِيلَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21695,
          "number": 60,
          "surah": "26",
          "page_number": 369,
          "text": "فَأَتْبَعُوهُم مُّشْرِقِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21696,
          "number": 61,
          "surah": "26",
          "page_number": 370,
          "text": "فَلَمَّا تَرَٰٓءَا اَ۬لْجَمْعَٰنِ قَالَ أَصْحَٰبُ مُوس۪يٰٓ إِنَّا لَمُدْرَكُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21697,
          "number": 62,
          "surah": "26",
          "page_number": 370,
          "text": "قَالَ كَلَّآۖ إِنَّ مَعِے رَبِّے سَيَهْدِينِۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21698,
          "number": 63,
          "surah": "26",
          "page_number": 370,
          "text": "فَأَوْحَيْنَآ إِلَيٰ مُوس۪يٰٓ أَنِ اِ۪ضْرِب بِّعَصَاكَ اَ۬لْبَحْرَ فَانفَلَقَ فَكَانَ كُلُّ فِرْقٖ كَالطَّوْدِ اِ۬لْعَظِيمِۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21699,
          "number": 64,
          "surah": "26",
          "page_number": 370,
          "text": "وَأَزْلَفْنَا ثَمَّ اَ۬لَاخَرِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21700,
          "number": 65,
          "surah": "26",
          "page_number": 370,
          "text": "وَأَنجَيْنَا مُوس۪يٰ وَمَن مَّعَهُۥٓ أَجْمَعِينَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21701,
          "number": 66,
          "surah": "26",
          "page_number": 370,
          "text": "ثُمَّ أَغْرَقْنَا اَ۬لَاخَرِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21702,
          "number": 67,
          "surah": "26",
          "page_number": 370,
          "text": "إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّومِنِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21703,
          "number": 68,
          "surah": "26",
          "page_number": 370,
          "text": "وَإِنَّ رَبَّكَ لَهُوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21704,
          "number": 69,
          "surah": "26",
          "page_number": 370,
          "text": "وَاتْلُ عَلَيْهِمْ نَبَأَ ا۪بْرَٰهِيمَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21705,
          "number": 70,
          "surah": "26",
          "page_number": 370,
          "text": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَا تَعْبُدُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21706,
          "number": 71,
          "surah": "26",
          "page_number": 370,
          "text": "قَالُواْ نَعْبُدُ أَصْنَاماٗ فَنَظَلُّ لَهَا عَٰكِفِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21707,
          "number": 72,
          "surah": "26",
          "page_number": 370,
          "text": "قَالَ هَلْ يَسْمَعُونَكُمُۥٓ إِذْ تَدْعُونَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21708,
          "number": 73,
          "surah": "26",
          "page_number": 370,
          "text": "أَوْ يَنفَعُونَكُمُۥٓ أَوْ يَضُرُّونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21709,
          "number": 74,
          "surah": "26",
          "page_number": 370,
          "text": "قَالُواْ بَلْ وَجَدْنَآ ءَابَآءَنَا كَذَٰلِكَ يَفْعَلُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21710,
          "number": 75,
          "surah": "26",
          "page_number": 370,
          "text": "قَالَ أَفَرَٰٓيْتُم مَّا كُنتُمْ تَعْبُدُونَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21711,
          "number": 76,
          "surah": "26",
          "page_number": 370,
          "text": "أَنتُمْ وَءَابَآؤُكُمُ اُ۬لَاقْدَمُونَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21712,
          "number": 77,
          "surah": "26",
          "page_number": 370,
          "text": "فَإِنَّهُمْ عَدُوّٞ لِّيَ إِلَّا رَبَّ اَ۬لْعَٰلَمِينَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21713,
          "number": 78,
          "surah": "26",
          "page_number": 370,
          "text": "اَ۬لذِے خَلَقَنِے فَهُوَ يَهْدِينِۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21714,
          "number": 79,
          "surah": "26",
          "page_number": 370,
          "text": "وَالذِے هُوَ يُطْعِمُنِے وَيَسْقِينِ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21715,
          "number": 80,
          "surah": "26",
          "page_number": 370,
          "text": "وَإِذَا مَرِضْتُ فَهُوَ يَشْفِينِۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21716,
          "number": 81,
          "surah": "26",
          "page_number": 370,
          "text": "وَالذِے يُمِيتُنِے ثُمَّ يُحْيِينِۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21717,
          "number": 82,
          "surah": "26",
          "page_number": 370,
          "text": "۞وَالذِےٓ أَطْمَعُ أَنْ يَّغْفِرَ لِے خَطِيٓـَٔتِے يَوْمَ اَ۬لدِّينِۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21718,
          "number": 83,
          "surah": "26",
          "page_number": 370,
          "text": "رَبِّ هَبْ لِے حُكْماٗ وَأَلْحِقْنِے بِالصَّٰلِحِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21719,
          "number": 84,
          "surah": "26",
          "page_number": 371,
          "text": "وَاجْعَل لِّے لِسَانَ صِدْقٖ فِے اِ۬لَاخِرِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21720,
          "number": 85,
          "surah": "26",
          "page_number": 371,
          "text": "وَاجْعَلْنِے مِنْ وَّرَثَةِ جَنَّةِ اِ۬لنَّعِيمِۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21721,
          "number": 86,
          "surah": "26",
          "page_number": 371,
          "text": "وَاغْفِرْ لِأَبِيَ إِنَّهُۥ كَانَ مِنَ اَ۬لضَّآلِّينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21722,
          "number": 87,
          "surah": "26",
          "page_number": 371,
          "text": "وَلَا تُخْزِنِے يَوْمَ يُبْعَثُونَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21723,
          "number": 88,
          "surah": "26",
          "page_number": 371,
          "text": "يَوْمَ لَا يَنفَعُ مَالٞ وَلَا بَنُونَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21724,
          "number": 89,
          "surah": "26",
          "page_number": 371,
          "text": "إِلَّا مَنَ اَتَي اَ۬للَّهَ بِقَلْبٖ سَلِيمٖۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21725,
          "number": 90,
          "surah": "26",
          "page_number": 371,
          "text": "وَأُزْلِفَتِ اِ۬لْجَنَّةُ لِلْمُتَّقِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21726,
          "number": 91,
          "surah": "26",
          "page_number": 371,
          "text": "وَبُرِّزَتِ اِ۬لْجَحِيمُ لِلْغَاوِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21727,
          "number": 92,
          "surah": "26",
          "page_number": 371,
          "text": "وَقِيلَ لَهُمُۥٓ أَيْنَ مَا كُنتُمْ تَعْبُدُونَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21728,
          "number": 93,
          "surah": "26",
          "page_number": 371,
          "text": "مِن دُونِ اِ۬للَّهِ هَلْ يَنصُرُونَكُمُۥٓ أَوْ يَنتَصِرُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21729,
          "number": 94,
          "surah": "26",
          "page_number": 371,
          "text": "فَكُبْكِبُواْ فِيهَا هُمْ وَالْغَاوُۥنَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21730,
          "number": 95,
          "surah": "26",
          "page_number": 371,
          "text": "وَجُنُودُ إِبْلِيسَ أَجْمَعُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21731,
          "number": 96,
          "surah": "26",
          "page_number": 371,
          "text": "قَالُواْ وَهُمْ فِيهَا يَخْتَصِمُونَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21732,
          "number": 97,
          "surah": "26",
          "page_number": 371,
          "text": "تَاللَّهِ إِن كُنَّا لَفِے ضَلَٰلٖ مُّبِينٍ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21733,
          "number": 98,
          "surah": "26",
          "page_number": 371,
          "text": "اِذْ نُسَوِّيكُم بِرَبِّ اِ۬لْعَٰلَمِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21734,
          "number": 99,
          "surah": "26",
          "page_number": 371,
          "text": "وَمَآ أَضَلَّنَآ إِلَّا اَ۬لْمُجْرِمُونَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21735,
          "number": 100,
          "surah": "26",
          "page_number": 371,
          "text": "فَمَا لَنَا مِن شَٰفِعِينَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21736,
          "number": 101,
          "surah": "26",
          "page_number": 371,
          "text": "وَلَا صَدِيقٍ حَمِيمٖۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21737,
          "number": 102,
          "surah": "26",
          "page_number": 371,
          "text": "فَلَوَ اَنَّ لَنَا كَرَّةٗ فَنَكُونَ مِنَ اَ۬لْمُومِنِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21738,
          "number": 103,
          "surah": "26",
          "page_number": 371,
          "text": "إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّومِنِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21739,
          "number": 104,
          "surah": "26",
          "page_number": 371,
          "text": "وَإِنَّ رَبَّكَ لَهُوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21740,
          "number": 105,
          "surah": "26",
          "page_number": 371,
          "text": "كَذَّبَتْ قَوْمُ نُوحٍ اِ۬لْمُرْسَلِينَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21741,
          "number": 106,
          "surah": "26",
          "page_number": 371,
          "text": "إِذْ قَالَ لَهُمُۥٓ أَخُوهُمْ نُوحٌ اَلَا تَتَّقُونَ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21742,
          "number": 107,
          "surah": "26",
          "page_number": 371,
          "text": "إِنِّے لَكُمْ رَسُولٌ اَمِينٞۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21743,
          "number": 108,
          "surah": "26",
          "page_number": 371,
          "text": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21744,
          "number": 109,
          "surah": "26",
          "page_number": 371,
          "text": "وَمَآ أَسْــَٔلُكُمْ عَلَيْهِ مِنَ اَجْرٍۖ اِنَ اَجْرِيَ إِلَّا عَلَيٰ رَبِّ اِ۬لْعَٰلَمِينَۖ",
          "juz": 19,
          "hizb": 37
        },
        {
          "id": 21745,
          "number": 110,
          "surah": "26",
          "page_number": 371,
          "text": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ",
          "juz": 19,
