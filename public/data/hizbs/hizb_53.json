{
  "mushaf_id": 4,
  "mushaf_name": "مصحف ورش",
  "hizb": 53,
  "surahs": [
    {
      "id": 51,
      "name": "سورة الذاريات",
      "coded_name": "ﯠ",
      "ayahs": [
        {
          "id": 23394,
          "number": 31,
          "surah": "51",
          "page_number": 522,
          "text": "۞قَالَ فَمَا خَطْبُكُمُۥٓ أَيُّهَا اَ۬لْمُرْسَلُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23395,
          "number": 32,
          "surah": "51",
          "page_number": 522,
          "text": "قَالُوٓاْ إِنَّآ أُرْسِلْنَآ إِلَيٰ قَوْمٖ مُّجْرِمِينَ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23396,
          "number": 33,
          "surah": "51",
          "page_number": 522,
          "text": "لِنُرْسِلَ عَلَيْهِمْ حِجَارَةٗ مِّن طِينٖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23397,
          "number": 34,
          "surah": "51",
          "page_number": 522,
          "text": "مُّسَوَّمَةً عِندَ رَبِّكَ لِلْمُسْرِفِينَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23398,
          "number": 35,
          "surah": "51",
          "page_number": 522,
          "text": "فَأَخْرَجْنَا مَن كَانَ فِيهَا مِنَ اَ۬لْمُومِنِينَ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23399,
          "number": 36,
          "surah": "51",
          "page_number": 522,
          "text": "فَمَا وَجَدْنَا فِيهَا غَيْرَ بَيْتٖ مِّنَ اَ۬لْمُسْلِمِينَ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23400,
          "number": 37,
          "surah": "51",
          "page_number": 522,
          "text": "وَتَرَكْنَا فِيهَآ ءَايَةٗ لِّلذِينَ يَخَافُونَ اَ۬لْعَذَابَ اَ۬لَالِيمَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23401,
          "number": 38,
          "surah": "51",
          "page_number": 522,
          "text": "وَفِے مُوس۪يٰٓ إِذَ اَرْسَلْنَٰهُ إِلَيٰ فِرْعَوْنَ بِسُلْطَٰنٖ مُّبِينٖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23402,
          "number": 39,
          "surah": "51",
          "page_number": 522,
          "text": "فَتَوَلّ۪يٰ بِرُكْنِهِۦ وَقَالَ سَٰحِرٌ اَوْ مَجْنُونٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23403,
          "number": 40,
          "surah": "51",
          "page_number": 522,
          "text": "فَأَخَذْنَٰهُ وَجُنُودَهُۥ فَنَبَذْنَٰهُمْ فِے اِ۬لْيَمِّ وَهُوَ مُلِيمٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23404,
          "number": 41,
          "surah": "51",
          "page_number": 522,
          "text": "وَفِے عَادٍ اِذَ اَرْسَلْنَا عَلَيْهِمُ اُ۬لرِّيحَ اَ۬لْعَقِيمَ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23405,
          "number": 42,
          "surah": "51",
          "page_number": 522,
          "text": "مَا تَذَرُ مِن شَےْءٍ اَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَالرَّمِيمِۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23406,
          "number": 43,
          "surah": "51",
          "page_number": 522,
          "text": "وَفِے ثَمُودَ إِذْ قِيلَ لَهُمْ تَمَتَّعُواْ حَتَّيٰ حِينٖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23407,
          "number": 44,
          "surah": "51",
          "page_number": 522,
          "text": "فَعَتَوْاْ عَنَ اَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ اُ۬لصَّٰعِقَةُ وَهُمْ يَنظُرُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23408,
          "number": 45,
          "surah": "51",
          "page_number": 522,
          "text": "فَمَا اَ۪سْتَطَٰعُواْ مِن قِيَامٖ وَمَا كَانُواْ مُنتَصِرِينَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23409,
          "number": 46,
          "surah": "51",
          "page_number": 522,
          "text": "وَقَوْمَ نُوحٖ مِّن قَبْلُۖ إِنَّهُمْ كَانُواْ قَوْماٗ فَٰسِقِينَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23410,
          "number": 47,
          "surah": "51",
          "page_number": 522,
          "text": "وَالسَّمَآءَ بَنَيْنَٰهَا بِأَيَيْدٖۖ وَإِنَّا لَمُوسِعُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23411,
          "number": 48,
          "surah": "51",
          "page_number": 522,
          "text": "وَالَارْضَ فَرَشْنَٰهَا فَنِعْمَ اَ۬لْمَٰهِدُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23412,
          "number": 49,
          "surah": "51",
          "page_number": 522,
          "text": "وَمِن كُلِّ شَےْءٍ خَلَقْنَا زَوْجَيْنِ لَعَلَّكُمْ تَذَّكَّرُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23413,
          "number": 50,
          "surah": "51",
          "page_number": 522,
          "text": "فَفِرُّوٓاْ إِلَي اَ۬للَّهِ إِنِّے لَكُم مِّنْهُ نَذِيرٞ مُّبِينٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23414,
          "number": 51,
          "surah": "51",
          "page_number": 522,
          "text": "وَلَا تَجْعَلُواْ مَعَ اَ۬للَّهِ إِلَٰهاً اٰخَرَ إِنِّے لَكُم مِّنْهُ نَذِيرٞ مُّبِينٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23415,
          "number": 52,
          "surah": "51",
          "page_number": 523,
          "text": "كَذَٰلِكَۖ مَآ أَتَي اَ۬لذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ اِلَّا قَالُواْ سَاحِرٌ اَوْ مَجْنُونٌۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23416,
          "number": 53,
          "surah": "51",
          "page_number": 523,
          "text": "اَتَوَاصَوْاْ بِهِۦۖ بَلْ هُمْ قَوْمٞ طَاغُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23417,
          "number": 54,
          "surah": "51",
          "page_number": 523,
          "text": "فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومٖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23418,
          "number": 55,
          "surah": "51",
          "page_number": 523,
          "text": "وَذَكِّرْ فَإِنَّ اَ۬لذِّكْر۪يٰ تَنفَعُ اُ۬لْمُومِنِينَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23419,
          "number": 56,
          "surah": "51",
          "page_number": 523,
          "text": "۞وَمَا خَلَقْتُ اُ۬لْجِنَّ وَالِانسَ إِلَّا لِيَعْبُدُونِۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23420,
          "number": 57,
          "surah": "51",
          "page_number": 523,
          "text": "مَآ أُرِيدُ مِنْهُم مِّن رِّزْقٖ وَمَآ أُرِيدُ أَنْ يُّطْعِمُونِۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23421,
          "number": 58,
          "surah": "51",
          "page_number": 523,
          "text": "إِنَّ اَ۬للَّهَ هُوَ اَ۬لرَّزَّاقُ ذُو اُ۬لْقُوَّةِ اِ۬لْمَتِينُۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23422,
          "number": 59,
          "surah": "51",
          "page_number": 523,
          "text": "فَإِنَّ لِلذِينَ ظَلَمُواْ ذَنُوباٗ مِّثْلَ ذَنُوبِ أَصْحَٰبِهِمْ فَلَا يَسْتَعْجِلُونِۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23423,
          "number": 60,
          "surah": "51",
          "page_number": 523,
          "text": "فَوَيْلٞ لِّلذِينَ كَفَرُواْ مِنْ يَّوْمِهِمُ اُ۬لذِے يُوعَدُونَۖ",
          "juz": 27,
          "hizb": 53
        }
      ]
    },
    {
      "id": 52,
      "name": "سورة الطور",
      "coded_name": "ﯡ",
      "ayahs": [
        {
          "id": 23424,
          "number": 1,
          "surah": "52",
          "page_number": 523,
          "text": "وَالطُّورِ وَكِتَٰبٖ مَّسْطُورٖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23425,
          "number": 2,
          "surah": "52",
          "page_number": 523,
          "text": "فِے رَقّٖ مَّنشُورٖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23426,
          "number": 3,
          "surah": "52",
          "page_number": 523,
          "text": "وَالْبَيْتِ اِ۬لْمَعْمُورِ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23427,
          "number": 4,
          "surah": "52",
          "page_number": 523,
          "text": "وَالسَّقْفِ اِ۬لْمَرْفُوعِ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23428,
          "number": 5,
          "surah": "52",
          "page_number": 523,
          "text": "وَالْبَحْرِ اِ۬لْمَسْجُورِ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23429,
          "number": 6,
          "surah": "52",
          "page_number": 523,
          "text": "إِنَّ عَذَابَ رَبِّكَ لَوَٰقِعٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23430,
          "number": 7,
          "surah": "52",
          "page_number": 523,
          "text": "مَّا لَهُۥ مِن دَافِعٖۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23431,
          "number": 8,
          "surah": "52",
          "page_number": 523,
          "text": "يَوْمَ تَمُورُ اُ۬لسَّمَآءُ مَوْراٗ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23432,
          "number": 9,
          "surah": "52",
          "page_number": 523,
          "text": "وَتَسِيرُ اُ۬لْجِبَالُ سَيْراٗۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23433,
          "number": 10,
          "surah": "52",
          "page_number": 523,
          "text": "فَوَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23434,
          "number": 11,
          "surah": "52",
          "page_number": 523,
          "text": "اَ۬لذِينَ هُمْ فِے خَوْضٖ يَلْعَبُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23435,
          "number": 12,
          "surah": "52",
          "page_number": 523,
          "text": "يَوْمَ يُدَعُّونَ إِلَيٰ ن۪ارِ جَهَنَّمَ دَعّاًۖ هَٰذِهِ اِ۬لنَّارُ اُ۬لتِے كُنتُم بِهَا تُكَذِّبُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23436,
          "number": 13,
          "surah": "52",
          "page_number": 524,
          "text": "أَفَسِحْرٌ هَٰذَآ أَمَ اَنتُمْ لَا تُبْصِرُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23437,
          "number": 14,
          "surah": "52",
          "page_number": 524,
          "text": "اَ۪صْلَوْهَا فَاصْبِرُوٓاْ أَوْ لَا تَصْبِرُواْ سَوَآءٌ عَلَيْكُمُۥٓۖ إِنَّمَا تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23438,
          "number": 15,
          "surah": "52",
          "page_number": 524,
          "text": "إِنَّ اَ۬لْمُتَّقِينَ فِے جَنَّٰتٖ وَنَعِيمٖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23439,
          "number": 16,
          "surah": "52",
          "page_number": 524,
          "text": "فَٰكِهِينَ بِمَآ ءَات۪يٰهُمْ رَبُّهُمْ وَوَق۪يٰهُمْ رَبُّهُمْ عَذَابَ اَ۬لْجَحِيمِۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23440,
          "number": 17,
          "surah": "52",
          "page_number": 524,
          "text": "كُلُواْ وَاشْرَبُواْ هَنِيٓــٔاَۢ بِمَا كُنتُمْ تَعْمَلُونَ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23441,
          "number": 18,
          "surah": "52",
          "page_number": 524,
          "text": "مُتَّكِـِٕينَ عَلَيٰ سُرُرٖ مَّصْفُوفَةٖ وَزَوَّجْنَٰهُم بِحُورٍ عِينٖۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23442,
          "number": 19,
          "surah": "52",
          "page_number": 524,
          "text": "وَالذِينَ ءَامَنُواْ وَاتَّبَعَتْهُمْ ذُرِّيَّتُهُم بِإِيمَٰنٍ اَلْحَقْنَا بِهِمْ ذُرِّيَّٰتِهِمْ وَمَآ أَلَتْنَٰهُم مِّنْ عَمَلِهِم مِّن شَےْءٖۖ كُلُّ اُ۪مْرِےِٕۢ بِمَا كَسَبَ رَهِينٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23443,
          "number": 20,
          "surah": "52",
          "page_number": 524,
          "text": "وَأَمْدَدْنَٰهُم بِفَٰكِهَةٖ وَلَحْمٖ مِّمَّا يَشْتَهُونَ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23444,
          "number": 21,
          "surah": "52",
          "page_number": 524,
          "text": "يَتَنَٰزَعُونَ فِيهَا كَأْساٗ لَّا لَغْوٞ فِيهَا وَلَا تَاثِيمٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23445,
          "number": 22,
          "surah": "52",
          "page_number": 524,
          "text": "۞وَيَطُوفُ عَلَيْهِمْ غِلْمَانٞ لَّهُمْ كَأَنَّهُمْ لُؤْلُؤٞ مَّكْنُونٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23446,
          "number": 23,
          "surah": "52",
          "page_number": 524,
          "text": "وَأَقْبَلَ بَعْضُهُمْ عَلَيٰ بَعْضٖ يَتَسَآءَلُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23447,
          "number": 24,
          "surah": "52",
          "page_number": 524,
          "text": "قَالُوٓاْ إِنَّا كُنَّا قَبْلُ فِےٓ أَهْلِنَا مُشْفِقِينَ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23448,
          "number": 25,
          "surah": "52",
          "page_number": 524,
          "text": "فَمَنَّ اَ۬للَّهُ عَلَيْنَا وَوَق۪يٰنَا عَذَابَ اَ۬لسَّمُومِۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23449,
          "number": 26,
          "surah": "52",
          "page_number": 524,
          "text": "إِنَّا كُنَّا مِن قَبْلُ نَدْعُوهُ أَنَّهُۥ هُوَ اَ۬لْبَرُّ اُ۬لرَّحِيمُۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23450,
          "number": 27,
          "surah": "52",
          "page_number": 524,
          "text": "فَذَكِّرْ فَمَآ أَنتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٖ وَلَا مَجْنُونٍۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23451,
          "number": 28,
          "surah": "52",
          "page_number": 524,
          "text": "اَمْ يَقُولُونَ شَاعِرٞ نَّتَرَبَّصُ بِهِۦ رَيْبَ اَ۬لْمَنُونِۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23452,
          "number": 29,
          "surah": "52",
          "page_number": 524,
          "text": "قُلْ تَرَبَّصُواْ فَإِنِّے مَعَكُم مِّنَ اَ۬لْمُتَرَبِّصِينَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23453,
          "number": 30,
          "surah": "52",
          "page_number": 525,
          "text": "أَمْ تَامُرُهُمُۥٓ أَحْلَٰمُهُم بِهَٰذَآ أَمْ هُمْ قَوْمٞ طَاغُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23454,
          "number": 31,
          "surah": "52",
          "page_number": 525,
          "text": "أَمْ يَقُولُونَ تَقَوَّلَهُۥۖ بَل لَّا يُومِنُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23455,
          "number": 32,
          "surah": "52",
          "page_number": 525,
          "text": "فَلْيَاتُواْ بِحَدِيثٖ مِّثْلِهِۦٓ إِن كَانُواْ صَٰدِقِينَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23456,
          "number": 33,
          "surah": "52",
          "page_number": 525,
          "text": "أَمْ خُلِقُواْ مِنْ غَيْرِ شَےْءٍ اَمْ هُمُ اُ۬لْخَٰلِقُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23457,
          "number": 34,
          "surah": "52",
          "page_number": 525,
          "text": "أَمْ خَلَقُواْ اُ۬لسَّمَٰوَٰتِ وَالَارْضَۖ بَل لَّا يُوقِنُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23458,
          "number": 35,
          "surah": "52",
          "page_number": 525,
          "text": "أَمْ عِندَهُمْ خَزَآئِنُ رَبِّكَ أَمْ هُمُ اُ۬لْمُصَيْطِرُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23459,
          "number": 36,
          "surah": "52",
          "page_number": 525,
          "text": "أَمْ لَهُمْ سُلَّمٞ يَسْتَمِعُونَ فِيهِۖ فَلْيَاتِ مُسْتَمِعُهُم بِسُلْطَٰنٖ مُّبِينٍۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23460,
          "number": 37,
          "surah": "52",
          "page_number": 525,
          "text": "اَمْ لَهُ اُ۬لْبَنَٰتُ وَلَكُمُ اُ۬لْبَنُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23461,
          "number": 38,
          "surah": "52",
          "page_number": 525,
          "text": "أَمْ تَسْــَٔلُهُمُۥٓ أَجْراٗ فَهُم مِّن مَّغْرَمٖ مُّثْقَلُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23462,
          "number": 39,
          "surah": "52",
          "page_number": 525,
          "text": "أَمْ عِندَهُمُ اُ۬لْغَيْبُ فَهُمْ يَكْتُبُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23463,
          "number": 40,
          "surah": "52",
          "page_number": 525,
          "text": "أَمْ يُرِيدُونَ كَيْداٗۖ فَالذِينَ كَفَرُواْ هُمُ اُ۬لْمَكِيدُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23464,
          "number": 41,
          "surah": "52",
          "page_number": 525,
          "text": "أَمْ لَهُمُۥٓ إِلَٰهٌ غَيْرُ اُ۬للَّهِۖ سُبْحَٰنَ اَ۬للَّهِ عَمَّا يُشْرِكُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23465,
          "number": 42,
          "surah": "52",
          "page_number": 525,
          "text": "۞وَإِنْ يَّرَوْاْ كِسْفاٗ مِّنَ اَ۬لسَّمَآءِ سَاقِطاٗ يَقُولُواْ سَحَابٞ مَّرْكُومٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23466,
          "number": 43,
          "surah": "52",
          "page_number": 525,
          "text": "فَذَرْهُمْ حَتَّيٰ يُلَٰقُواْ يَوْمَهُمُ اُ۬لذِے فِيهِ يَصْعَقُونَ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23467,
          "number": 44,
          "surah": "52",
          "page_number": 525,
          "text": "يَوْمَ لَا يُغْنِے عَنْهُمْ كَيْدُهُمْ شَيْـٔاٗ وَلَا هُمْ يُنصَرُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23468,
          "number": 45,
          "surah": "52",
          "page_number": 525,
          "text": "وَإِنَّ لِلذِينَ ظَلَمُواْ عَذَاباٗ دُونَ ذَٰلِكَ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23469,
          "number": 46,
          "surah": "52",
          "page_number": 525,
          "text": "وَاصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَاۖ وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَقُومُۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23470,
          "number": 47,
          "surah": "52",
          "page_number": 525,
          "text": "وَمِنَ اَ۬ليْلِ فَسَبِّحْهُ وَإِدْبَٰرَ اَ۬لنُّجُومِۖ",
          "juz": 27,
          "hizb": 53
        }
      ]
    },
    {
      "id": 53,
      "name": "سورة النجم",
      "coded_name": "ﯢ",
      "ayahs": [
        {
          "id": 23471,
          "number": 1,
          "surah": "53",
          "page_number": 526,
          "text": "وَالنَّجْمِ إِذَا هَو۪يٰ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23472,
          "number": 2,
          "surah": "53",
          "page_number": 526,
          "text": "مَا ضَلَّ صَٰحِبُكُمْ وَمَا غَو۪يٰ",
