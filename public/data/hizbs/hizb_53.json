          "hizb": 53
        },
        {
          "id": 23475,
          "number": 5,
          "surah": "53",
          "page_number": 526,
          "text": "عَلَّمَهُۥ شَدِيدُ اُ۬لْقُو۪يٰ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23476,
          "number": 6,
          "surah": "53",
          "page_number": 526,
          "text": "ذُو مِرَّةٖ فَاسْتَو۪يٰ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23477,
          "number": 7,
          "surah": "53",
          "page_number": 526,
          "text": "وَهُوَ بِالُافُقِ اِ۬لَاعْل۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23478,
          "number": 8,
          "surah": "53",
          "page_number": 526,
          "text": "ثُمَّ دَنَا فَتَدَلّ۪يٰ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23479,
          "number": 9,
          "surah": "53",
          "page_number": 526,
          "text": "فَكَانَ قَابَ قَوْسَيْنِ أَوَ اَدْن۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23480,
          "number": 10,
          "surah": "53",
          "page_number": 526,
          "text": "فَأَوْح۪يٰٓ إِلَيٰ عَبْدِهِۦ مَآ أَوْح۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23481,
          "number": 11,
          "surah": "53",
          "page_number": 526,
          "text": "مَا كَذَبَ اَ۬لْفُؤَادُ مَا ر۪أ۪يٰٓۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23482,
          "number": 12,
          "surah": "53",
          "page_number": 526,
          "text": "أَفَتُمَٰرُونَهُۥ عَلَيٰ مَا يَر۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23483,
          "number": 13,
          "surah": "53",
          "page_number": 526,
          "text": "وَلَقَدْ ر۪ء۪اهُ نَزْلَةً ا۟خْر۪يٰ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23484,
          "number": 14,
          "surah": "53",
          "page_number": 526,
          "text": "عِندَ سِدْرَةِ اِ۬لْمُنتَه۪يٰ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23485,
          "number": 15,
          "surah": "53",
          "page_number": 526,
          "text": "عِندَهَا جَنَّةُ اُ۬لْمَأْو۪يٰٓ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23486,
          "number": 16,
          "surah": "53",
          "page_number": 526,
          "text": "إِذْ يَغْشَي اَ۬لسِّدْرَةَ مَا يَغْش۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23487,
          "number": 17,
          "surah": "53",
          "page_number": 526,
          "text": "مَا زَاغَ اَ۬لْبَصَرُ وَمَا طَغ۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23488,
          "number": 18,
          "surah": "53",
          "page_number": 526,
          "text": "لَقَدْ ر۪أ۪يٰ مِنَ اٰيَٰتِ رَبِّهِ اِ۬لْكُبْر۪يٰٓۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23489,
          "number": 19,
          "surah": "53",
          "page_number": 526,
          "text": "أَفَرَٰٓيْتُمُ اُ۬للَّٰتَ وَالْعُزّ۪يٰ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23490,
          "number": 20,
          "surah": "53",
          "page_number": 526,
          "text": "وَمَنَوٰةَ اَ۬لثَّالِثَةَ اَ۬لُاخْر۪يٰٓ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23491,
          "number": 21,
          "surah": "53",
          "page_number": 526,
          "text": "أَلَكُمُ اُ۬لذَّكَرُ وَلَهُ اُ۬لُانث۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23492,
          "number": 22,
          "surah": "53",
          "page_number": 526,
          "text": "تِلْكَ إِذاٗ قِسْمَةٞ ضِيز۪يٰٓۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23493,
          "number": 23,
          "surah": "53",
          "page_number": 526,
          "text": "إِنْ هِيَ إِلَّآ أَسْمَآءٞ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ اَ۬للَّهُ بِهَا مِن سُلْطَٰنٍۖ اِنْ يَّتَّبِعُونَ إِلَّا اَ۬لظَّنَّ وَمَا تَهْوَي اَ۬لَانفُسُۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ اُ۬لْهُد۪يٰٓۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23494,
          "number": 24,
          "surah": "53",
          "page_number": 526,
          "text": "أَمْ لِلِانسَٰنِ مَا تَمَنّ۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23495,
          "number": 25,
          "surah": "53",
          "page_number": 526,
          "text": "فَلِلهِ اِ۬لَاخِرَةُ وَالُاول۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23496,
          "number": 26,
          "surah": "53",
          "page_number": 526,
          "text": "۞وَكَم مِّن مَّلَكٖ فِے اِ۬لسَّمَٰوَٰتِ لَا تُغْنِے شَفَٰعَتُهُمْ شَيْـٔاً اِلَّا مِنۢ بَعْدِ أَنْ يَّاذَنَ اَ۬للَّهُ لِمَنْ يَّشَآءُ وَيَرْض۪يٰٓۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23497,
          "number": 27,
          "surah": "53",
          "page_number": 527,
          "text": "إِنَّ اَ۬لذِينَ لَا يُومِنُونَ بِالَاخِرَةِ لَيُسَمُّونَ اَ۬لْمَلَٰٓئِكَةَ تَسْمِيَةَ اَ۬لُانث۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23498,
          "number": 28,
          "surah": "53",
          "page_number": 527,
          "text": "وَمَا لَهُم بِهِۦ مِنْ عِلْمٍۖ اِنْ يَّتَّبِعُونَ إِلَّا اَ۬لظَّنَّۖ وَإِنَّ اَ۬لظَّنَّ لَا يُغْنِے مِنَ اَ۬لْحَقِّ شَيْـٔاٗۖ فَأَعْرِضْ عَن مَّن تَوَلّ۪يٰ عَن ذِكْرِنَا وَلَمْ يُرِدِ اِلَّا اَ۬لْحَيَوٰةَ اَ۬لدُّنْي۪اۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23499,
          "number": 29,
          "surah": "53",
          "page_number": 527,
          "text": "ذَٰلِكَ مَبْلَغُهُم مِّنَ اَ۬لْعِلْمِۖ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ اِ۪هْتَد۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23500,
          "number": 30,
          "surah": "53",
          "page_number": 527,
          "text": "وَلِلهِ مَا فِے اِ۬لسَّمَٰوَٰتِ وَمَا فِے اِ۬لَارْضِ لِيَجْزِيَ اَ۬لذِينَ أَسَٰٓــُٔواْ بِمَا عَمِلُواْ وَيَجْزِيَ اَ۬لذِينَ أَحْسَنُواْ بِالْحُسْنَيۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23501,
          "number": 31,
          "surah": "53",
          "page_number": 527,
          "text": "اَ۬لذِينَ يَجْتَنِبُونَ كَبَٰٓئِرَ اَ۬لِاثْمِ وَالْفَوَٰحِشَ إِلَّا اَ۬للَّمَمَۖ إِنَّ رَبَّكَ وَٰسِعُ اُ۬لْمَغْفِرَةِۖ هُوَ أَعْلَمُ بِكُمُۥٓ إِذَ اَنشَأَكُم مِّنَ اَ۬لَارْضِ وَإِذَ اَنتُمُۥٓ أَجِنَّةٞ فِے بُطُونِ أُمَّهَٰتِكُمْۖ فَلَا تُزَكُّوٓاْ أَنفُسَكُمْۖ هُوَ أَعْلَمُ بِمَنِ اِ۪تَّق۪يٰٓۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23502,
          "number": 32,
          "surah": "53",
          "page_number": 527,
          "text": "أَفَرَٰٓيْتَ اَ۬لذِے تَوَلّ۪يٰ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23503,
          "number": 33,
          "surah": "53",
          "page_number": 527,
          "text": "وَأَعْط۪يٰ قَلِيلاٗ وَأَكْد۪يٰٓ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23504,
          "number": 34,
          "surah": "53",
          "page_number": 527,
          "text": "أَعِندَهُۥ عِلْمُ اُ۬لْغَيْبِ فَهُوَ يَر۪يٰٓۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23505,
          "number": 35,
          "surah": "53",
          "page_number": 527,
          "text": "أَمْ لَمْ يُنَبَّأْ بِمَا فِے صُحُفِ مُوس۪يٰ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23506,
          "number": 36,
          "surah": "53",
          "page_number": 527,
          "text": "وَإِبْرَٰهِيمَ اَ۬لذِے وَفّ۪يٰٓ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23507,
          "number": 37,
          "surah": "53",
          "page_number": 527,
          "text": "أَلَّا تَزِرُ وَازِرَةٞ وِزْرَ أُخْر۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23508,
          "number": 38,
          "surah": "53",
          "page_number": 527,
          "text": "وَأَن لَّيْسَ لِلِانسَٰنِ إِلَّا مَا سَع۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23509,
          "number": 39,
          "surah": "53",
          "page_number": 527,
          "text": "وَأَنَّ سَعْيَهُۥ سَوْفَ يُر۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23510,
          "number": 40,
          "surah": "53",
          "page_number": 527,
          "text": "ثُمَّ يُجْز۪يٰهُ اُ۬لْجَزَآءَ اَ۬لَاوْف۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23511,
          "number": 41,
          "surah": "53",
          "page_number": 527,
          "text": "وَأَنَّ إِلَيٰ رَبِّكَ اَ۬لْمُنتَه۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23512,
          "number": 42,
          "surah": "53",
          "page_number": 527,
          "text": "وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْك۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23513,
          "number": 43,
          "surah": "53",
          "page_number": 527,
          "text": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْي۪اۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23514,
          "number": 44,
          "surah": "53",
          "page_number": 528,
          "text": "وَأَنَّهُۥ خَلَقَ اَ۬لزَّوْجَيْنِ اِ۬لذَّكَرَ وَالُانث۪يٰ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23515,
          "number": 45,
          "surah": "53",
          "page_number": 528,
          "text": "مِن نُّطْفَةٍ اِذَا تُمْن۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23516,
          "number": 46,
          "surah": "53",
          "page_number": 528,
          "text": "۞وَأَنَّ عَلَيْهِ اِ۬لنَّشْأَةَ اَ۬لُاخْر۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23517,
          "number": 47,
          "surah": "53",
          "page_number": 528,
          "text": "وَأَنَّهُۥ هُوَ أَغْن۪يٰ وَأَقْن۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23518,
          "number": 48,
          "surah": "53",
          "page_number": 528,
          "text": "وَأَنَّهُۥ هُوَ رَبُّ اُ۬لشِّعْر۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23519,
          "number": 49,
          "surah": "53",
          "page_number": 528,
          "text": "وَأَنَّهُۥٓ أَهْلَكَ عَاداٗ اَ۬لُّاول۪يٰ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23520,
          "number": 50,
          "surah": "53",
          "page_number": 528,
          "text": "وَثَمُوداٗ فَمَآ أَبْق۪يٰ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23521,
          "number": 51,
          "surah": "53",
          "page_number": 528,
          "text": "وَقَوْمَ نُوحٖ مِّن قَبْلُۖ إِنَّهُمْ كَانُواْ هُمُۥٓ أَظْلَمَ وَأَطْغ۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23522,
          "number": 52,
          "surah": "53",
          "page_number": 528,
          "text": "وَالْمُوتَفِكَةَ أَهْو۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23523,
          "number": 53,
          "surah": "53",
          "page_number": 528,
          "text": "فَغَشّ۪يٰهَا مَا غَشّ۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23524,
          "number": 54,
          "surah": "53",
          "page_number": 528,
          "text": "فَبِأَيِّ ءَالَآءِ رَبِّكَ تَتَمَار۪يٰۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23525,
          "number": 55,
          "surah": "53",
          "page_number": 528,
          "text": "هَٰذَا نَذِيرٞ مِّنَ اَ۬لنُّذُرِ اِ۬لُاول۪يٰٓۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23526,
          "number": 56,
          "surah": "53",
          "page_number": 528,
          "text": "أَزِفَتِ اِ۬لَازِفَةُۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23527,
          "number": 57,
          "surah": "53",
          "page_number": 528,
          "text": "لَيْسَ لَهَا مِن دُونِ اِ۬للَّهِ كَاشِفَةٌۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23528,
          "number": 58,
          "surah": "53",
          "page_number": 528,
          "text": "اَفَمِنْ هَٰذَا اَ۬لْحَدِيثِ تَعْجَبُونَ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23529,
          "number": 59,
          "surah": "53",
          "page_number": 528,
          "text": "وَتَضْحَكُونَ وَلَا تَبْكُونَ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23530,
          "number": 60,
          "surah": "53",
          "page_number": 528,
          "text": "وَأَنتُمْ سَٰمِدُونَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23531,
          "number": 61,
          "surah": "53",
          "page_number": 528,
          "text": "فَاسْجُدُواْ لِلهِ وَاعْبُدُواْ۩ۖ",
          "juz": 27,
          "hizb": 53
        }
      ]
    },
    {
      "id": 54,
      "name": "سورة القمر",
      "coded_name": "ﯣ",
      "ayahs": [
        {
          "id": 23532,
          "number": 1,
          "surah": "54",
          "page_number": 528,
          "text": "اُ۪قْتَرَبَتِ اِ۬لسَّاعَةُ وَانشَقَّ اَ۬لْقَمَرُۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23533,
          "number": 2,
          "surah": "54",
          "page_number": 528,
          "text": "وَإِنْ يَّرَوَاْ اٰيَةٗ يُعْرِضُواْ وَيَقُولُواْ سِحْرٞ مُّسْتَمِرّٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23534,
          "number": 3,
          "surah": "54",
          "page_number": 528,
          "text": "وَكَذَّبُواْ وَاتَّبَعُوٓاْ أَهْوَآءَهُمْۖ وَكُلُّ أَمْرٖ مُّسْتَقِرّٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23535,
          "number": 4,
          "surah": "54",
          "page_number": 528,
          "text": "وَلَقَدْ جَآءَهُم مِّنَ اَ۬لَانۢبَآءِ مَا فِيهِ مُزْدَجَرٌۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23536,
          "number": 5,
          "surah": "54",
          "page_number": 528,
          "text": "حِكْمَةُۢ بَٰلِغَةٞۖ فَمَا تُغْنِ اِ۬لنُّذُرُۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23537,
          "number": 6,
          "surah": "54",
          "page_number": 528,
          "text": "فَتَوَلَّ عَنْهُمْۖ يَوْمَ يَدْعُ اُ۬لدَّاعِۦٓ إِلَيٰ شَےْءٖ نُّكُرٍ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23538,
          "number": 7,
          "surah": "54",
          "page_number": 529,
          "text": "خُشَّعاً اَبْصَٰرُهُمْ يَخْرُجُونَ مِنَ اَ۬لَاجْدَاثِ كَأَنَّهُمْ جَرَادٞ مُّنتَشِرٞ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23539,
          "number": 8,
          "surah": "54",
          "page_number": 529,
          "text": "مُّهْطِعِينَ إِلَي اَ۬لدَّاعِۦۖ يَقُولُ اُ۬لْكَٰفِرُونَ هَٰذَا يَوْمٌ عَسِرٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23540,
          "number": 9,
          "surah": "54",
          "page_number": 529,
          "text": "كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٖ فَكَذَّبُواْ عَبْدَنَا وَقَالُواْ مَجْنُونٞ وَازْدُجِرَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23541,
          "number": 10,
          "surah": "54",
          "page_number": 529,
          "text": "۞فَدَعَا رَبَّهُۥٓ أَنِّے مَغْلُوبٞ فَانتَصِرْۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23542,
          "number": 11,
          "surah": "54",
          "page_number": 529,
          "text": "فَفَتَحْنَآ أَبْوَٰبَ اَ۬لسَّمَآءِ بِمَآءٖ مُّنْهَمِرٖۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23543,
          "number": 12,
          "surah": "54",
          "page_number": 529,
          "text": "وَفَجَّرْنَا اَ۬لَارْضَ عُيُوناٗ فَالْتَقَي اَ۬لْمَآءُ عَلَيٰٓ أَمْرٖ قَدْ قُدِرَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23544,
          "number": 13,
          "surah": "54",
          "page_number": 529,
          "text": "وَحَمَلْنَٰهُ عَلَيٰ ذَاتِ أَلْوَٰحٖ وَدُسُرٖۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23545,
          "number": 14,
          "surah": "54",
          "page_number": 529,
          "text": "تَجْرِے بِأَعْيُنِنَا جَزَآءٗ لِّمَن كَانَ كُفِرَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23546,
          "number": 15,
          "surah": "54",
          "page_number": 529,
          "text": "وَلَقَد تَّرَكْنَٰهَآ ءَايَةٗ فَهَلْ مِن مُّدَّكِرٖۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23547,
          "number": 16,
          "surah": "54",
          "page_number": 529,
          "text": "فَكَيْفَ كَانَ عَذَابِے وَنُذُرِۦۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23548,
          "number": 17,
          "surah": "54",
          "page_number": 529,
          "text": "وَلَقَدْ يَسَّرْنَا اَ۬لْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٖۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23549,
          "number": 18,
          "surah": "54",
          "page_number": 529,
          "text": "كَذَّبَتْ عَادٞ فَكَيْفَ كَانَ عَذَابِے وَنُذُرِۦٓۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23550,
          "number": 19,
          "surah": "54",
          "page_number": 529,
          "text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ رِيحاٗ صَرْصَراٗ فِے يَوْمِ نَحْسٖ مُّسْتَمِرّٖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23551,
          "number": 20,
          "surah": "54",
          "page_number": 529,
          "text": "تَنزِعُ اُ۬لنَّاسَ كَأَنَّهُمُۥٓ أَعْجَازُ نَخْلٖ مُّنقَعِرٖۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23552,
          "number": 21,
          "surah": "54",
          "page_number": 529,
          "text": "فَكَيْفَ كَانَ عَذَابِے وَنُذُرِۦۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23553,
          "number": 22,
          "surah": "54",
          "page_number": 529,
          "text": "وَلَقَدْ يَسَّرْنَا اَ۬لْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٖۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23554,
          "number": 23,
          "surah": "54",
          "page_number": 529,
          "text": "كَذَّبَتْ ثَمُودُ بِالنُّذُرِۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23555,
          "number": 24,
          "surah": "54",
          "page_number": 529,
          "text": "فَقَالُوٓاْ أَبَشَراٗ مِّنَّا وَٰحِداٗ نَّتَّبِعُهُۥٓ إِنَّآ إِذاٗ لَّفِے ضَلَٰلٖ وَسُعُرٍ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23556,
          "number": 25,
          "surah": "54",
          "page_number": 529,
          "text": "اَ۟لْقِيَ اَ۬لذِّكْرُ عَلَيْهِ مِنۢ بَيْنِنَا بَلْ هُوَ كَذَّابٌ اَشِرٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23557,
          "number": 26,
          "surah": "54",
          "page_number": 529,
          "text": "سَيَعْلَمُونَ غَداٗ مَّنِ اِ۬لْكَذَّابُ اُ۬لَاشِرُۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23558,
          "number": 27,
          "surah": "54",
          "page_number": 529,
          "text": "إِنَّا مُرْسِلُواْ اُ۬لنَّاقَةِ فِتْنَةٗ لَّهُمْ فَارْتَقِبْهُمْ وَاصْطَبِرْۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23559,
          "number": 28,
          "surah": "54",
          "page_number": 530,
          "text": "وَنَبِّيـْٔهُمُۥٓ أَنَّ اَ۬لْمَآءَ قِسْمَةُۢ بَيْنَهُمْۖ كُلُّ شِرْبٖ مُّحْتَضَرٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23560,
          "number": 29,
          "surah": "54",
          "page_number": 530,
          "text": "فَنَادَوْاْ صَٰحِبَهُمْ فَتَعَاط۪يٰ فَعَقَرَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23561,
          "number": 30,
          "surah": "54",
          "page_number": 530,
          "text": "فَكَيْفَ كَانَ عَذَابِے وَنُذُرِۦٓۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23562,
          "number": 31,
          "surah": "54",
          "page_number": 530,
          "text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ صَيْحَةٗ وَٰحِدَةٗ فَكَانُواْ كَهَشِيمِ اِ۬لْمُحْتَظِرِۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23563,
          "number": 32,
          "surah": "54",
          "page_number": 530,
          "text": "وَلَقَدْ يَسَّرْنَا اَ۬لْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٖۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23564,
          "number": 33,
          "surah": "54",
          "page_number": 530,
          "text": "كَذَّبَتْ قَوْمُ لُوطِۢ بِالنُّذُرِۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23565,
          "number": 34,
          "surah": "54",
          "page_number": 530,
          "text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ حَاصِباً اِلَّآ ءَالَ لُوطٖ نَّجَّيْنَٰهُم بِسَحَرٖۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23566,
          "number": 35,
          "surah": "54",
          "page_number": 530,
          "text": "نِّعْمَةٗ مِّنْ عِندِنَاۖ كَذَٰلِكَ نَجْزِے مَن شَكَرَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23567,
          "number": 36,
          "surah": "54",
          "page_number": 530,
          "text": "وَلَقَدَ اَنذَرَهُم بَطْشَتَنَا فَتَمَارَوْاْ بِالنُّذُرِۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23568,
          "number": 37,
          "surah": "54",
          "page_number": 530,
          "text": "۞وَلَقَدْ رَٰوَدُوهُ عَن ضَيْفِهِۦ فَطَمَسْنَآ أَعْيُنَهُمْ فَذُوقُواْ عَذَابِے وَنُذُرِۦۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23569,
          "number": 38,
          "surah": "54",
          "page_number": 530,
          "text": "وَلَقَدْ صَبَّحَهُم بُكْرَةً عَذَابٞ مُّسْتَقِرّٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23570,
          "number": 39,
          "surah": "54",
          "page_number": 530,
          "text": "فَذُوقُواْ عَذَابِے وَنُذُرِۦۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23571,
          "number": 40,
          "surah": "54",
          "page_number": 530,
          "text": "وَلَقَدْ يَسَّرْنَا اَ۬لْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٖۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23572,
          "number": 41,
          "surah": "54",
          "page_number": 530,
          "text": "وَلَقَدْ جَآءَ ا۟لَ فِرْعَوْنَ اَ۬لنُّذُرُۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23573,
          "number": 42,
          "surah": "54",
          "page_number": 530,
          "text": "كَذَّبُواْ بِــَٔايَٰتِنَا كُلِّهَا فَأَخَذْنَٰهُمُۥٓ أَخْذَ عَزِيزٖ مُّقْتَدِرٍۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23574,
          "number": 43,
          "surah": "54",
          "page_number": 530,
          "text": "اَكُفَّارُكُمْ خَيْرٞ مِّنُ ا۟وْلَٰٓئِكُمُۥٓ أَمْ لَكُم بَرَآءَةٞ فِے اِ۬لزُّبُرِۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23575,
          "number": 44,
          "surah": "54",
          "page_number": 530,
          "text": "أَمْ يَقُولُونَ نَحْنُ جَمِيعٞ مُّنتَصِرٞۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23576,
          "number": 45,
          "surah": "54",
          "page_number": 530,
          "text": "سَيُهْزَمُ اُ۬لْجَمْعُ وَيُوَلُّونَ اَ۬لدُّبُرَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23577,
          "number": 46,
          "surah": "54",
          "page_number": 530,
          "text": "بَلِ اِ۬لسَّاعَةُ مَوْعِدُهُمْ وَالسَّاعَةُ أَدْه۪يٰ وَأَمَرُّۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23578,
          "number": 47,
          "surah": "54",
          "page_number": 530,
          "text": "إِنَّ اَ۬لْمُجْرِمِينَ فِے ضَلَٰلٖ وَسُعُرٖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23579,
          "number": 48,
          "surah": "54",
          "page_number": 530,
          "text": "يَوْمَ يُسْحَبُونَ فِے اِ۬لنّ۪ارِ عَلَيٰ وُجُوهِهِمْ ذُوقُواْ مَسَّ سَقَرَۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23580,
          "number": 49,
          "surah": "54",
          "page_number": 530,
          "text": "إِنَّا كُلَّ شَےْءٍ خَلَقْنَٰهُ بِقَدَرٖۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23581,
          "number": 50,
          "surah": "54",
          "page_number": 531,
          "text": "وَمَآ أَمْرُنَآ إِلَّا وَٰحِدَةٞ كَلَمْحِۢ بِالْبَصَرِۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23582,
          "number": 51,
          "surah": "54",
          "page_number": 531,
          "text": "وَلَقَدَ اَهْلَكْنَآ أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرٖۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23583,
          "number": 52,
          "surah": "54",
          "page_number": 531,
          "text": "وَكُلُّ شَےْءٖ فَعَلُوهُ فِے اِ۬لزُّبُرِۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23584,
          "number": 53,
          "surah": "54",
          "page_number": 531,
          "text": "وَكُلُّ صَغِيرٖ وَكَبِيرٖ مُّسْتَطَرٌۖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23585,
          "number": 54,
          "surah": "54",
          "page_number": 531,
          "text": "اِنَّ اَ۬لْمُتَّقِينَ فِے جَنَّٰتٖ وَنَهَرٖ",
          "juz": 27,
          "hizb": 53
        },
        {
          "id": 23586,
          "number": 55,
          "surah": "54",
          "page_number": 531,
          "text": "فِے مَقْعَدِ صِدْقٍ عِندَ مَلِيكٖ مُّقْتَدِرٍۖ",
          "juz": 27,
          "hizb": 53
        }
      ]
    }
  ]
}