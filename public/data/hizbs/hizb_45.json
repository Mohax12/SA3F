{
  "mushaf_id": 4,
  "mushaf_name": "مصحف ورش",
  "hizb": 45,
  "surahs": [
    {
      "id": 36,
      "name": "سورة يس",
      "coded_name": "ﮰ",
      "ayahs": [
        {
          "id": 22435,
          "number": 27,
          "surah": "36",
          "page_number": 442,
          "text": "۞وَمَآ أَنزَلْنَا عَلَيٰ قَوْمِهِۦ مِنۢ بَعْدِهِۦ مِن جُندٖ مِّنَ اَ۬لسَّمَآءِ وَمَا كُنَّا مُنزِلِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22436,
          "number": 28,
          "surah": "36",
          "page_number": 442,
          "text": "إِن كَانَتِ اِلَّا صَيْحَةٗ وَٰحِدَةٗ فَإِذَا هُمْ خَٰمِدُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22437,
          "number": 29,
          "surah": "36",
          "page_number": 442,
          "text": "يَٰحَسْرَةً عَلَي اَ۬لْعِبَادِۖ مَا يَاتِيهِم مِّن رَّسُولٍ اِلَّا كَانُواْ بِهِۦ يَسْتَهْزِءُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22438,
          "number": 30,
          "surah": "36",
          "page_number": 442,
          "text": "أَلَمْ يَرَوْاْ كَمَ اَهْلَكْنَا قَبْلَهُم مِّنَ اَ۬لْقُرُونِ أَنَّهُمُۥٓ إِلَيْهِمْ لَا يَرْجِعُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22439,
          "number": 31,
          "surah": "36",
          "page_number": 442,
          "text": "وَإِن كُلّٞ لَّمَا جَمِيعٞ لَّدَيْنَا مُحْضَرُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22440,
          "number": 32,
          "surah": "36",
          "page_number": 442,
          "text": "وَءَايَةٞ لَّهُمُ اُ۬لَارْضُ اُ۬لْمَيِّتَةُ أَحْيَيْنَٰهَا وَأَخْرَجْنَا مِنْهَا حَبّاٗ فَمِنْهُ يَاكُلُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22441,
          "number": 33,
          "surah": "36",
          "page_number": 442,
          "text": "وَجَعَلْنَا فِيهَا جَنَّٰتٖ مِّن نَّخِيلٖ وَأَعْنَٰبٖ وَفَجَّرْنَا فِيهَا مِنَ اَ۬لْعُيُونِ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22442,
          "number": 34,
          "surah": "36",
          "page_number": 442,
          "text": "لِيَاكُلُواْ مِن ثَمَرِهِۦ وَمَا عَمِلَتْهُ أَيْدِيهِمُۥٓۖ أَفَلَا يَشْكُرُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22443,
          "number": 35,
          "surah": "36",
          "page_number": 442,
          "text": "سُبْحَٰنَ اَ۬لذِے خَلَقَ اَ۬لَازْوَٰجَ كُلَّهَا مِمَّا تُنۢبِتُ اُ۬لَارْضُ وَمِنَ اَنفُسِهِمْ وَمِمَّا لَا يَعْلَمُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22444,
          "number": 36,
          "surah": "36",
          "page_number": 442,
          "text": "وَءَايَةٞ لَّهُمُ اُ۬ليْلُ نَسْلَخُ مِنْهُ اُ۬لنَّهَارَ فَإِذَا هُم مُّظْلِمُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22445,
          "number": 37,
          "surah": "36",
          "page_number": 442,
          "text": "وَالشَّمْسُ تَجْرِے لِمُسْتَقَرّٖ لَّهَاۖ ذَٰلِكَ تَقْدِيرُ اُ۬لْعَزِيزِ اِ۬لْعَلِيمِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22446,
          "number": 38,
          "surah": "36",
          "page_number": 442,
          "text": "وَالْقَمَرُ قَدَّرْنَٰهُ مَنَازِلَ حَتَّيٰ عَادَ كَالْعُرْجُونِ اِ۬لْقَدِيمِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22447,
          "number": 39,
          "surah": "36",
          "page_number": 442,
          "text": "لَا اَ۬لشَّمْسُ يَنۢبَغِے لَهَآ أَن تُدْرِكَ اَ۬لْقَمَرَ وَلَا اَ۬ليْلُ سَابِقُ اُ۬لنَّه۪ارِۖ وَكُلّٞ فِے فَلَكٖ يَسْبَحُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22448,
          "number": 40,
          "surah": "36",
          "page_number": 443,
          "text": "وَءَايَةٞ لَّهُمُۥٓ أَنَّا حَمَلْنَا ذُرِّيَّٰتِهِمْ فِے اِ۬لْفُلْكِ اِ۬لْمَشْحُونِ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22449,
          "number": 41,
          "surah": "36",
          "page_number": 443,
          "text": "وَخَلَقْنَا لَهُم مِّن مِّثْلِهِۦ مَا يَرْكَبُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22450,
          "number": 42,
          "surah": "36",
          "page_number": 443,
          "text": "وَإِن نَّشَأْ نُغْرِقْهُمْ فَلَا صَرِيخَ لَهُمْ وَلَا هُمْ يُنقَذُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22451,
          "number": 43,
          "surah": "36",
          "page_number": 443,
          "text": "إِلَّا رَحْمَةٗ مِّنَّا وَمَتَٰعاً اِلَيٰ حِينٖۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22452,
          "number": 44,
          "surah": "36",
          "page_number": 443,
          "text": "وَإِذَا قِيلَ لَهُمُ اُ۪تَّقُواْ مَا بَيْنَ أَيْدِيكُمْ وَمَا خَلْفَكُمْ لَعَلَّكُمْ تُرْحَمُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22453,
          "number": 45,
          "surah": "36",
          "page_number": 443,
          "text": "۞وَمَا تَاتِيهِم مِّنَ اٰيَةٖ مِّنَ اٰيَٰتِ رَبِّهِمُۥٓ إِلَّا كَانُواْ عَنْهَا مُعْرِضِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22454,
          "number": 46,
          "surah": "36",
          "page_number": 443,
          "text": "وَإِذَا قِيلَ لَهُمُۥٓ أَنفِقُواْ مِمَّا رَزَقَكُمُ اُ۬للَّهُ قَالَ اَ۬لذِينَ كَفَرُواْ لِلذِينَ ءَامَنُوٓاْ أَنُطْعِمُ مَن لَّوْ يَشَآءُ اُ۬للَّهُ أَطْعَمَهُۥٓ إِنَ اَنتُمُۥٓ إِلَّا فِے ضَلَٰلٖ مُّبِينٖۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22455,
          "number": 47,
          "surah": "36",
          "page_number": 443,
          "text": "وَيَقُولُونَ مَت۪يٰ هَٰذَا اَ۬لْوَعْدُ إِن كُنتُمْ صَٰدِقِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22456,
          "number": 48,
          "surah": "36",
          "page_number": 443,
          "text": "مَا يَنظُرُونَ إِلَّا صَيْحَةٗ وَٰحِدَةٗ تَاخُذُهُمْ وَهُمْ يَخَصِّمُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22457,
          "number": 49,
          "surah": "36",
          "page_number": 443,
          "text": "فَلَا يَسْتَطِيعُونَ تَوْصِيَةٗ وَلَآ إِلَيٰٓ أَهْلِهِمْ يَرْجِعُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22458,
          "number": 50,
          "surah": "36",
          "page_number": 443,
          "text": "وَنُفِخَ فِے اِ۬لصُّورِ فَإِذَا هُم مِّنَ اَ۬لَاجْدَاثِ إِلَيٰ رَبِّهِمْ يَنسِلُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22459,
          "number": 51,
          "surah": "36",
          "page_number": 443,
          "text": "قَالُواْ يَٰوَيْلَنَا مَنۢ بَعَثَنَا مِن مَّرْقَدِنَاۖ هَٰذَا مَا وَعَدَ اَ۬لرَّحْمَٰنُ وَصَدَقَ اَ۬لْمُرْسَلُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22460,
          "number": 52,
          "surah": "36",
          "page_number": 443,
          "text": "إِن كَانَتِ اِلَّا صَيْحَةٗ وَٰحِدَةٗ فَإِذَا هُمْ جَمِيعٞ لَّدَيْنَا مُحْضَرُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22461,
          "number": 53,
          "surah": "36",
          "page_number": 443,
          "text": "فَالْيَوْمَ لَا تُظْلَمُ نَفْسٞ شَيْـٔاٗ وَلَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22462,
          "number": 54,
          "surah": "36",
          "page_number": 444,
          "text": "إِنَّ أَصْحَٰبَ اَ۬لْجَنَّةِ اِ۬لْيَوْمَ فِے شُغْلٖ فَٰكِهُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22463,
          "number": 55,
          "surah": "36",
          "page_number": 444,
          "text": "هُمْ وَأَزْوَٰجُهُمْ فِے ظِلَٰلٍ عَلَي اَ۬لَارَآئِكِ مُتَّكِــُٔونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22464,
          "number": 56,
          "surah": "36",
          "page_number": 444,
          "text": "لَهُمْ فِيهَا فَٰكِهَةٞ وَلَهُم مَّا يَدَّعُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22465,
          "number": 57,
          "surah": "36",
          "page_number": 444,
          "text": "سَلَٰمٞ قَوْلاٗ مِّن رَّبّٖ رَّحِيمٖۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22466,
          "number": 58,
          "surah": "36",
          "page_number": 444,
          "text": "وَامْتَٰزُواْ اُ۬لْيَوْمَ أَيُّهَا اَ۬لْمُجْرِمُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22467,
          "number": 59,
          "surah": "36",
          "page_number": 444,
          "text": "۞أَلَمَ اَعْهَدِ اِلَيْكُمْ يَٰبَنِےٓ ءَادَمَ أَن لَّا تَعْبُدُواْ اُ۬لشَّيْطَٰنَ إِنَّهُۥ لَكُمْ عَدُوّٞ مُّبِينٞ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22468,
          "number": 60,
          "surah": "36",
          "page_number": 444,
          "text": "وَأَنُ اُ۟عْبُدُونِےۖ هَٰذَا صِرَٰطٞ مُّسْتَقِيمٞۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22469,
          "number": 61,
          "surah": "36",
          "page_number": 444,
          "text": "وَلَقَدَ اَضَلَّ مِنكُمْ جِبِلّاٗ كَثِيراًۖ اَفَلَمْ تَكُونُواْ تَعْقِلُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22470,
          "number": 62,
          "surah": "36",
          "page_number": 444,
          "text": "هَٰذِهِۦ جَهَنَّمُ اُ۬لتِے كُنتُمْ تُوعَدُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22471,
          "number": 63,
          "surah": "36",
          "page_number": 444,
          "text": "اَ۪صْلَوْهَا اَ۬لْيَوْمَ بِمَا كُنتُمْ تَكْفُرُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22472,
          "number": 64,
          "surah": "36",
          "page_number": 444,
          "text": "اَ۬لْيَوْمَ نَخْتِمُ عَلَيٰٓ أَفْوَٰهِهِمْ وَتُكَلِّمُنَآ أَيْدِيهِمْ وَتَشْهَدُ أَرْجُلُهُم بِمَا كَانُواْ يَكْسِبُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22473,
          "number": 65,
          "surah": "36",
          "page_number": 444,
          "text": "وَلَوْ نَشَآءُ لَطَمَسْنَا عَلَيٰٓ أَعْيُنِهِمْ فَاسْتَبَقُواْ اُ۬لصِّرَٰطَ فَأَنّ۪يٰ يُبْصِرُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22474,
          "number": 66,
          "surah": "36",
          "page_number": 444,
          "text": "وَلَوْ نَشَآءُ لَمَسَخْنَٰهُمْ عَلَيٰ مَكَانَتِهِمْ فَمَا اَ۪سْتَطَٰعُواْ مُضِيّاٗ وَلَا يَرْجِعُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22475,
          "number": 67,
          "surah": "36",
          "page_number": 444,
          "text": "وَمَن نُّعَمِّرْهُ نَنكُسْهُ فِے اِ۬لْخَلْقِۖ أَفَلَا تَعْقِلُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22476,
          "number": 68,
          "surah": "36",
          "page_number": 444,
          "text": "وَمَا عَلَّمْنَٰهُ اُ۬لشِّعْرَ وَمَا يَنۢبَغِے لَهُۥٓۖ إِنْ هُوَ إِلَّا ذِكْرٞ وَقُرْءَانٞ مُّبِينٞ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22477,
          "number": 69,
          "surah": "36",
          "page_number": 444,
          "text": "لِّتُنذِرَ مَن كَانَ حَيّاٗ وَيَحِقَّ اَ۬لْقَوْلُ عَلَي اَ۬لْكٰ۪فِرِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22478,
          "number": 70,
          "surah": "36",
          "page_number": 445,
          "text": "أَوَلَمْ يَرَوَاْ اَنَّا خَلَقْنَا لَهُم مِّمَّا عَمِلَتَ اَيْدِينَآ أَنْعَٰماٗ فَهُمْ لَهَا مَٰلِكُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22479,
          "number": 71,
          "surah": "36",
          "page_number": 445,
          "text": "وَذَلَّلْنَٰهَا لَهُمْ فَمِنْهَا رَكُوبُهُمْ وَمِنْهَا يَاكُلُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22480,
          "number": 72,
          "surah": "36",
          "page_number": 445,
          "text": "وَلَهُمْ فِيهَا مَنَٰفِعُ وَمَشَارِبُۖ أَفَلَا يَشْكُرُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22481,
          "number": 73,
          "surah": "36",
          "page_number": 445,
          "text": "وَاتَّخَذُواْ مِن دُونِ اِ۬للَّهِ ءَالِهَةٗ لَّعَلَّهُمْ يُنصَرُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22482,
          "number": 74,
          "surah": "36",
          "page_number": 445,
          "text": "لَا يَسْتَطِيعُونَ نَصْرَهُمْ وَهُمْ لَهُمْ جُندٞ مُّحْضَرُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22483,
          "number": 75,
          "surah": "36",
          "page_number": 445,
          "text": "فَلَا يُحْزِنكَ قَوْلُهُمُۥٓۖ إِنَّا نَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22484,
          "number": 76,
          "surah": "36",
          "page_number": 445,
          "text": "أَوَلَمْ يَرَ اَ۬لِانسَٰنُ أَنَّا خَلَقْنَٰهُ مِن نُّطْفَةٖ فَإِذَا هُوَ خَصِيمٞ مُّبِينٞۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22485,
          "number": 77,
          "surah": "36",
          "page_number": 445,
          "text": "وَضَرَبَ لَنَا مَثَلاٗ وَنَسِيَ خَلْقَهُۥۖ قَالَ مَنْ يُّحْيِ اِ۬لْعِظَٰمَ وَهِيَ رَمِيمٞۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22486,
          "number": 78,
          "surah": "36",
          "page_number": 445,
          "text": "قُلْ يُحْيِيهَا اَ۬لذِےٓ أَنشَأَهَآ أَوَّلَ مَرَّةٖ وَهُوَ بِكُلِّ خَلْقٍ عَلِيمٌۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22487,
          "number": 79,
          "surah": "36",
          "page_number": 445,
          "text": "۞اِ۬لذِے جَعَلَ لَكُم مِّنَ اَ۬لشَّجَرِ اِ۬لَاخْضَرِ نَاراٗ فَإِذَآ أَنتُم مِّنْهُ تُوقِدُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22488,
          "number": 80,
          "surah": "36",
          "page_number": 445,
          "text": "أَوَلَيْسَ اَ۬لذِے خَلَقَ اَ۬لسَّمَٰوَٰتِ وَالَارْضَ بِقَٰدِرٍ عَلَيٰٓ أَنْ يَّخْلُقَ مِثْلَهُمۖ بَل۪يٰ وَهُوَ اَ۬لْخَلَّٰقُ اُ۬لْعَلِيمُۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22489,
          "number": 81,
          "surah": "36",
          "page_number": 445,
          "text": "إِنَّمَآ أَمْرُهُۥٓ إِذَآ أَرَادَ شَيْـٔاً اَنْ يَّقُولَ لَهُۥ كُن فَيَكُونُۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22490,
          "number": 82,
          "surah": "36",
          "page_number": 445,
          "text": "فَسُبْحَٰنَ اَ۬لذِے بِيَدِهِۦ مَلَكُوتُ كُلِّ شَےْءٖ وَإِلَيْهِ تُرْجَعُونَۖ",
          "juz": 23,
          "hizb": 45
        }
      ]
    },
    {
      "id": 37,
      "name": "سورة الصافات",
      "coded_name": "ﮱ",
      "ayahs": [
        {
          "id": 22491,
          "number": 1,
          "surah": "37",
          "page_number": 446,
          "text": "وَالصَّٰٓفَّٰتِ صَفّاٗ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22492,
          "number": 2,
          "surah": "37",
          "page_number": 446,
          "text": "فَالزَّٰجِرَٰتِ زَجْراٗ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22493,
          "number": 3,
          "surah": "37",
          "page_number": 446,
          "text": "فَالتَّٰلِيَٰتِ ذِكْراً",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22494,
          "number": 4,
          "surah": "37",
          "page_number": 446,
          "text": "اِنَّ إِلَٰهَكُمْ لَوَٰحِدٞۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22495,
          "number": 5,
          "surah": "37",
          "page_number": 446,
          "text": "رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَا وَرَبُّ اُ۬لْمَشَٰرِقِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22496,
          "number": 6,
          "surah": "37",
          "page_number": 446,
          "text": "إِنَّا زَيَّنَّا اَ۬لسَّمَآءَ اَ۬لدُّنْي۪ا بِزِينَةِ اِ۬لْكَوَاكِبِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22497,
          "number": 7,
          "surah": "37",
          "page_number": 446,
          "text": "وَحِفْظاٗ مِّن كُلِّ شَيْطَٰنٖ مَّارِدٖۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22498,
          "number": 8,
          "surah": "37",
          "page_number": 446,
          "text": "لَّا يَسْمَعُونَ إِلَي اَ۬لْمَلَإِ اِ۬لَاعْل۪يٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٖۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22499,
          "number": 9,
          "surah": "37",
          "page_number": 446,
          "text": "دُحُوراٗۖ وَلَهُمْ عَذَابٞ وَاصِبٌ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22500,
          "number": 10,
          "surah": "37",
          "page_number": 446,
          "text": "اِلَّا مَنْ خَطِفَ اَ۬لْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٞ ثَاقِبٞۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22501,
          "number": 11,
          "surah": "37",
          "page_number": 446,
          "text": "فَاسْتَفْتِهِمُۥٓ أَهُمُۥٓ أَشَدُّ خَلْقاً اَم مَّنْ خَلَقْنَآۖ إِنَّا خَلَقْنَٰهُم مِّن طِينٖ لَّٰزِبِۢۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22502,
          "number": 12,
          "surah": "37",
          "page_number": 446,
          "text": "بَلْ عَجِبْتَ وَيَسْخَرُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22503,
          "number": 13,
          "surah": "37",
          "page_number": 446,
          "text": "وَإِذَا ذُكِّرُواْ لَا يَذْكُرُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22504,
          "number": 14,
          "surah": "37",
          "page_number": 446,
          "text": "وَإِذَا رَأَوَاْ اٰيَةٗ يَسْتَسْخِرُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22505,
          "number": 15,
          "surah": "37",
          "page_number": 446,
          "text": "وَقَالُوٓاْ إِنْ هَٰذَآ إِلَّا سِحْرٞ مُّبِينٌ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22506,
          "number": 16,
          "surah": "37",
          "page_number": 446,
          "text": "اَ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَبْعُوثُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22507,
          "number": 17,
          "surah": "37",
          "page_number": 446,
          "text": "أَوَ ءَابَآؤُنَا اَ۬لَاوَّلُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22508,
          "number": 18,
          "surah": "37",
          "page_number": 446,
          "text": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22509,
          "number": 19,
          "surah": "37",
          "page_number": 446,
          "text": "فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ فَإِذَا هُمْ يَنظُرُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22510,
          "number": 20,
          "surah": "37",
          "page_number": 446,
          "text": "وَقَالُواْ يَٰوَيْلَنَا هَٰذَا يَوْمُ اُ۬لدِّينِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22511,
          "number": 21,
          "surah": "37",
          "page_number": 446,
          "text": "هَٰذَا يَوْمُ اُ۬لْفَصْلِ اِ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22512,
          "number": 22,
          "surah": "37",
          "page_number": 446,
          "text": "۞اَ۟حْشُرُواْ اُ۬لذِينَ ظَلَمُواْ وَأَزْوَٰجَهُمْ وَمَا كَانُواْ يَعْبُدُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22513,
          "number": 23,
          "surah": "37",
          "page_number": 446,
          "text": "مِن دُونِ اِ۬للَّهِ فَاهْدُوهُمُۥٓ إِلَيٰ صِرَٰطِ اِ۬لْجَحِيمِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22514,
          "number": 24,
          "surah": "37",
          "page_number": 446,
          "text": "وَقِفُوهُمُۥٓ إِنَّهُم مَّسْــُٔولُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22515,
          "number": 25,
          "surah": "37",
          "page_number": 447,
          "text": "مَا لَكُمْ لَا تَنَاصَرُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22516,
          "number": 26,
          "surah": "37",
          "page_number": 447,
          "text": "بَلْ هُمُ اُ۬لْيَوْمَ مُسْتَسْلِمُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22517,
          "number": 27,
          "surah": "37",
          "page_number": 447,
          "text": "وَأَقْبَلَ بَعْضُهُمْ عَلَيٰ بَعْضٖ يَتَسَآءَلُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22518,
          "number": 28,
          "surah": "37",
          "page_number": 447,
          "text": "قَالُوٓاْ إِنَّكُمْ كُنتُمْ تَاتُونَنَا عَنِ اِ۬لْيَمِينِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22519,
          "number": 29,
          "surah": "37",
          "page_number": 447,
          "text": "قَالُواْ بَل لَّمْ تَكُونُواْ مُومِنِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22520,
          "number": 30,
          "surah": "37",
          "page_number": 447,
          "text": "وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنِۢ بَلْ كُنتُمْ قَوْماٗ طَٰغِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22521,
          "number": 31,
          "surah": "37",
          "page_number": 447,
          "text": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ إِنَّا لَذَآئِقُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22522,
          "number": 32,
          "surah": "37",
          "page_number": 447,
          "text": "فَأَغْوَيْنَٰكُمُۥٓ إِنَّا كُنَّا غَٰوِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22523,
          "number": 33,
          "surah": "37",
          "page_number": 447,
          "text": "فَإِنَّهُمْ يَوْمَئِذٖ فِے اِ۬لْعَذَابِ مُشْتَرِكُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22524,
          "number": 34,
          "surah": "37",
          "page_number": 447,
          "text": "إِنَّا كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22525,
          "number": 35,
          "surah": "37",
          "page_number": 447,
          "text": "إِنَّهُمْ كَانُوٓاْ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا اَ۬للَّهُ يَسْتَكْبِرُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22526,
          "number": 36,
          "surah": "37",
          "page_number": 447,
          "text": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجْنُونِۢۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22527,
          "number": 37,
          "surah": "37",
          "page_number": 447,
          "text": "بَلْ جَآءَ بِالْحَقِّ وَصَدَّقَ اَ۬لْمُرْسَلِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22528,
          "number": 38,
          "surah": "37",
          "page_number": 447,
          "text": "إِنَّكُمْ لَذَآئِقُواْ اُ۬لْعَذَابِ اِ۬لَالِيمِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22529,
          "number": 39,
          "surah": "37",
          "page_number": 447,
          "text": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22530,
          "number": 40,
          "surah": "37",
          "page_number": 447,
          "text": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22531,
          "number": 41,
          "surah": "37",
          "page_number": 447,
          "text": "أُوْلَٰٓئِكَ لَهُمْ رِزْقٞ مَّعْلُومٞ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22532,
          "number": 42,
          "surah": "37",
          "page_number": 447,
          "text": "فَوَٰكِهُۖ وَهُم مُّكْرَمُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22533,
          "number": 43,
          "surah": "37",
          "page_number": 447,
          "text": "فِے جَنَّٰتِ اِ۬لنَّعِيمِ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22534,
          "number": 44,
          "surah": "37",
          "page_number": 447,
          "text": "عَلَيٰ سُرُرٖ مُّتَقَٰبِلِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22535,
          "number": 45,
          "surah": "37",
          "page_number": 447,
          "text": "يُطَافُ عَلَيْهِم بِكَأْسٖ مِّن مَّعِينِۢ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22536,
          "number": 46,
          "surah": "37",
          "page_number": 447,
          "text": "بَيْضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22537,
          "number": 47,
          "surah": "37",
          "page_number": 447,
          "text": "لَا فِيهَا غَوْلٞ وَلَا هُمْ عَنْهَا يُنزَفُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22538,
          "number": 48,
          "surah": "37",
          "page_number": 447,
          "text": "وَعِندَهُمْ قَٰصِرَٰتُ اُ۬لطَّرْفِ عِينٞ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22539,
          "number": 49,
          "surah": "37",
          "page_number": 447,
          "text": "كَأَنَّهُنَّ بَيْضٞ مَّكْنُونٞۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22540,
          "number": 50,
          "surah": "37",
          "page_number": 447,
          "text": "فَأَقْبَلَ بَعْضُهُمْ عَلَيٰ بَعْضٖ يَتَسَآءَلُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22541,
          "number": 51,
          "surah": "37",
          "page_number": 447,
          "text": "۞قَالَ قَآئِلٞ مِّنْهُمُۥٓ إِنِّے كَانَ لِے قَرِينٞ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22542,
          "number": 52,
          "surah": "37",
          "page_number": 448,
          "text": "يَقُولُ أَ۟نَّكَ لَمِنَ اَ۬لْمُصَدِّقِينَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22543,
          "number": 53,
          "surah": "37",
          "page_number": 448,
          "text": "أَ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَدِينُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22544,
          "number": 54,
          "surah": "37",
          "page_number": 448,
          "text": "قَالَ هَلَ اَنتُم مُّطَّلِعُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22545,
          "number": 55,
          "surah": "37",
          "page_number": 448,
          "text": "فَاطَّلَعَ فَر۪ء۪اهُ فِے سَوَآءِ اِ۬لْجَحِيمِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22546,
          "number": 56,
          "surah": "37",
          "page_number": 448,
          "text": "قَالَ تَاللَّهِ إِن كِدتَّ لَتُرْدِينِۦ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22547,
          "number": 57,
          "surah": "37",
          "page_number": 448,
          "text": "وَلَوْلَا نِعْمَةُ رَبِّے لَكُنتُ مِنَ اَ۬لْمُحْضَرِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22548,
          "number": 58,
          "surah": "37",
          "page_number": 448,
          "text": "أَفَمَا نَحْنُ بِمَيِّتِينَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22549,
          "number": 59,
          "surah": "37",
          "page_number": 448,
          "text": "إِلَّا مَوْتَتَنَا اَ۬لُاول۪يٰ وَمَا نَحْنُ بِمُعَذَّبِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22550,
          "number": 60,
          "surah": "37",
          "page_number": 448,
          "text": "إِنَّ هَٰذَا لَهُوَ اَ۬لْفَوْزُ اُ۬لْعَظِيمُۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22551,
          "number": 61,
          "surah": "37",
          "page_number": 448,
          "text": "لِمِثْلِ هَٰذَا فَلْيَعْمَلِ اِ۬لْعَٰمِلُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22552,
          "number": 62,
          "surah": "37",
          "page_number": 448,
          "text": "أَذَٰلِكَ خَيْرٞ نُّزُلاً اَمْ شَجَرَةُ اُ۬لزَّقُّومِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22553,
          "number": 63,
          "surah": "37",
          "page_number": 448,
          "text": "إِنَّا جَعَلْنَٰهَا فِتْنَةٗ لِّلظَّٰلِمِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22554,
          "number": 64,
          "surah": "37",
          "page_number": 448,
          "text": "إِنَّهَا شَجَرَةٞ تَخْرُجُ فِےٓ أَصْلِ اِ۬لْجَحِيمِ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22555,
          "number": 65,
          "surah": "37",
          "page_number": 448,
          "text": "طَلْعُهَا كَأَنَّهُۥ رُءُوسُ اُ۬لشَّيَٰطِينِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22556,
          "number": 66,
          "surah": "37",
          "page_number": 448,
          "text": "فَإِنَّهُمْ لَأٓكِلُونَ مِنْهَا فَمَالِــُٔونَ مِنْهَا اَ۬لْبُطُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22557,
          "number": 67,
          "surah": "37",
          "page_number": 448,
          "text": "ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْباٗ مِّنْ حَمِيمٖۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22558,
          "number": 68,
          "surah": "37",
          "page_number": 448,
          "text": "ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَي اَ۬لْجَحِيمِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22559,
          "number": 69,
          "surah": "37",
          "page_number": 448,
          "text": "إِنَّهُمُۥٓ أَلْفَوَاْ اٰبَآءَهُمْ ضَآلِّينَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22560,
          "number": 70,
          "surah": "37",
          "page_number": 448,
          "text": "فَهُمْ عَلَيٰٓ ءَاثٰ۪رِهِمْ يُهْرَعُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22561,
          "number": 71,
          "surah": "37",
          "page_number": 448,
          "text": "وَلَقَد ضَّلَّ قَبْلَهُمُۥٓ أَكْثَرُ اُ۬لَاوَّلِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22562,
          "number": 72,
          "surah": "37",
          "page_number": 448,
          "text": "وَلَقَدَ اَرْسَلْنَا فِيهِم مُّنذِرِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22563,
          "number": 73,
          "surah": "37",
          "page_number": 448,
          "text": "فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُنذَرِينَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22564,
          "number": 74,
          "surah": "37",
          "page_number": 448,
          "text": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22565,
          "number": 75,
          "surah": "37",
          "page_number": 448,
          "text": "وَلَقَدْ نَاد۪يٰنَا نُوحٞ فَلَنِعْمَ اَ۬لْمُجِيبُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22566,
          "number": 76,
          "surah": "37",
          "page_number": 448,
          "text": "وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22567,
          "number": 77,
          "surah": "37",
          "page_number": 449,
          "text": "وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ اُ۬لْبَاقِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22568,
          "number": 78,
          "surah": "37",
          "page_number": 449,
          "text": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22569,
          "number": 79,
          "surah": "37",
          "page_number": 449,
          "text": "سَلَٰمٌ عَلَيٰ نُوحٖ فِے اِ۬لْعَٰلَمِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22570,
          "number": 80,
          "surah": "37",
          "page_number": 449,
          "text": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22571,
          "number": 81,
          "surah": "37",
          "page_number": 449,
          "text": "إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22572,
          "number": 82,
          "surah": "37",
          "page_number": 449,
          "text": "ثُمَّ أَغْرَقْنَا اَ۬لَاخَرِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22573,
          "number": 83,
          "surah": "37",
          "page_number": 449,
          "text": "۞وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22574,
          "number": 84,
          "surah": "37",
          "page_number": 449,
          "text": "إِذْ جَآءَ رَبَّهُۥ بِقَلْبٖ سَلِيمٍ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22575,
          "number": 85,
          "surah": "37",
          "page_number": 449,
          "text": "اِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22576,
          "number": 86,
          "surah": "37",
          "page_number": 449,
          "text": "أَئِفْكاً اٰلِهَةٗ دُونَ اَ۬للَّهِ تُرِيدُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22577,
          "number": 87,
          "surah": "37",
          "page_number": 449,
          "text": "فَمَا ظَنُّكُم بِرَبِّ اِ۬لْعَٰلَمِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22578,
          "number": 88,
          "surah": "37",
          "page_number": 449,
          "text": "فَنَظَرَ نَظْرَةٗ فِے اِ۬لنُّجُومِ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22579,
          "number": 89,
          "surah": "37",
          "page_number": 449,
          "text": "فَقَالَ إِنِّے سَقِيمٞ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22580,
          "number": 90,
          "surah": "37",
          "page_number": 449,
          "text": "فَتَوَلَّوْاْ عَنْهُ مُدْبِرِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22581,
          "number": 91,
          "surah": "37",
          "page_number": 449,
          "text": "فَرَاغَ إِلَيٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَاكُلُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22582,
          "number": 92,
          "surah": "37",
          "page_number": 449,
          "text": "مَا لَكُمْ لَا تَنطِقُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22583,
          "number": 93,
          "surah": "37",
          "page_number": 449,
          "text": "فَرَاغَ عَلَيْهِمْ ضَرْباَۢ بِالْيَمِينِ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22584,
          "number": 94,
          "surah": "37",
          "page_number": 449,
          "text": "فَأَقْبَلُوٓاْ إِلَيْهِ يَزِفُّونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22585,
          "number": 95,
          "surah": "37",
          "page_number": 449,
          "text": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22586,
          "number": 96,
          "surah": "37",
          "page_number": 449,
          "text": "وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22587,
          "number": 97,
          "surah": "37",
          "page_number": 449,
          "text": "قَالُواْ اُ۪بْنُواْ لَهُۥ بُنْيَٰناٗ فَأَلْقُوهُ فِے اِ۬لْجَحِيمِ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22588,
          "number": 98,
          "surah": "37",
          "page_number": 449,
          "text": "فَأَرَادُواْ بِهِۦ كَيْداٗ فَجَعَلْنَٰهُمُ اُ۬لَاسْفَلِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22589,
          "number": 99,
          "surah": "37",
          "page_number": 449,
          "text": "وَقَالَ إِنِّے ذَاهِبٌ اِلَيٰ رَبِّے سَيَهْدِينِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22590,
          "number": 100,
          "surah": "37",
          "page_number": 449,
          "text": "رَبِّ هَبْ لِے مِنَ اَ۬لصَّٰلِحِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22591,
          "number": 101,
          "surah": "37",
          "page_number": 449,
          "text": "فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمٖۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22592,
          "number": 102,
          "surah": "37",
          "page_number": 449,
          "text": "فَلَمَّا بَلَغَ مَعَهُ اُ۬لسَّعْيَ قَالَ يَٰبُنَيِّ إِنِّيَ أَر۪يٰ فِے اِ۬لْمَنَامِ أَنِّيَ أَذْبَحُكَ فَانظُرْ مَاذَا تَر۪يٰۖ قَالَ يَٰٓأَبَتِ اِ۪فْعَلْ مَا تُومَرُۖ سَتَجِدُنِيَ إِن شَآءَ اَ۬للَّهُ مِنَ اَ۬لصَّٰبِرِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22593,
          "number": 103,
          "surah": "37",
          "page_number": 450,
          "text": "فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22594,
          "number": 104,
          "surah": "37",
          "page_number": 450,
          "text": "وَنَٰدَيْنَٰهُ أَنْ يَّٰٓإِبْرَٰهِيمُ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22595,
          "number": 105,
          "surah": "37",
          "page_number": 450,
          "text": "قَدْ صَدَّقْتَ اَ۬لرُّءْي۪آۖ إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22596,
          "number": 106,
          "surah": "37",
          "page_number": 450,
          "text": "إِنَّ هَٰذَا لَهُوَ اَ۬لْبَلَٰٓؤُاْ اُ۬لْمُبِينُۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22597,
          "number": 107,
          "surah": "37",
          "page_number": 450,
          "text": "وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٖۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22598,
          "number": 108,
          "surah": "37",
          "page_number": 450,
          "text": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22599,
          "number": 109,
          "surah": "37",
          "page_number": 450,
          "text": "سَلَٰمٌ عَلَيٰٓ إِبْرَٰهِيمَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22600,
          "number": 110,
          "surah": "37",
          "page_number": 450,
          "text": "كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22601,
          "number": 111,
          "surah": "37",
          "page_number": 450,
          "text": "إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22602,
          "number": 112,
          "surah": "37",
          "page_number": 450,
          "text": "وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيٓــٔاٗ مِّنَ اَ۬لصَّٰلِحِينَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22603,
          "number": 113,
          "surah": "37",
          "page_number": 450,
          "text": "وَبَٰرَكْنَا عَلَيْهِ وَعَلَيٰٓ إِسْحَٰقَۖ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٞ وَظَالِمٞ لِّنَفْسِهِۦ مُبِينٞۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22604,
          "number": 114,
          "surah": "37",
          "page_number": 450,
          "text": "۞وَلَقَدْ مَنَنَّا عَلَيٰ مُوس۪يٰ وَهَٰرُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22605,
          "number": 115,
          "surah": "37",
          "page_number": 450,
          "text": "وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22606,
          "number": 116,
          "surah": "37",
          "page_number": 450,
          "text": "وَنَصَرْنَٰهُمْ فَكَانُواْ هُمُ اُ۬لْغَٰلِبِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22607,
          "number": 117,
          "surah": "37",
          "page_number": 450,
          "text": "وَءَاتَيْنَٰهُمَا اَ۬لْكِتَٰبَ اَ۬لْمُسْتَبِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22608,
          "number": 118,
          "surah": "37",
          "page_number": 450,
          "text": "وَهَدَيْنَٰهُمَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22609,
          "number": 119,
          "surah": "37",
          "page_number": 450,
          "text": "وَتَرَكْنَا عَلَيْهِمَا فِے اِ۬لَاخِرِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22610,
          "number": 120,
          "surah": "37",
          "page_number": 450,
          "text": "سَلَٰمٌ عَلَيٰ مُوس۪يٰ وَهَٰرُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22611,
          "number": 121,
          "surah": "37",
          "page_number": 450,
          "text": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22612,
          "number": 122,
          "surah": "37",
          "page_number": 450,
          "text": "إِنَّهُمَا مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22613,
          "number": 123,
          "surah": "37",
          "page_number": 450,
          "text": "وَإِنَّ إِلْيَاسَ لَمِنَ اَ۬لْمُرْسَلِينَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22614,
          "number": 124,
          "surah": "37",
          "page_number": 450,
          "text": "إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22615,
          "number": 125,
          "surah": "37",
          "page_number": 450,
          "text": "أَتَدْعُونَ بَعْلاٗ وَتَذَرُونَ أَحْسَنَ اَ۬لْخَٰلِقِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22616,
          "number": 126,
          "surah": "37",
          "page_number": 450,
          "text": "اَ۬للَّهُ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ اُ۬لَاوَّلِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22617,
          "number": 127,
          "surah": "37",
          "page_number": 451,
          "text": "فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22618,
          "number": 128,
          "surah": "37",
          "page_number": 451,
          "text": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22619,
          "number": 129,
          "surah": "37",
          "page_number": 451,
          "text": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22620,
          "number": 130,
          "surah": "37",
          "page_number": 451,
          "text": "سَلَٰمٌ عَلَيٰٓ ءَالِ يَاسِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22621,
          "number": 131,
          "surah": "37",
          "page_number": 451,
          "text": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22622,
          "number": 132,
          "surah": "37",
          "page_number": 451,
          "text": "إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22623,
          "number": 133,
          "surah": "37",
          "page_number": 451,
          "text": "وَإِنَّ لُوطاٗ لَّمِنَ اَ۬لْمُرْسَلِينَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22624,
          "number": 134,
          "surah": "37",
          "page_number": 451,
          "text": "إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22625,
          "number": 135,
          "surah": "37",
          "page_number": 451,
          "text": "إِلَّا عَجُوزاٗ فِے اِ۬لْغَٰبِرِينَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22626,
          "number": 136,
          "surah": "37",
          "page_number": 451,
          "text": "ثُمَّ دَمَّرْنَا اَ۬لَاخَرِينَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22627,
          "number": 137,
          "surah": "37",
          "page_number": 451,
          "text": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22628,
          "number": 138,
          "surah": "37",
          "page_number": 451,
          "text": "وَبِاليْلِۖ أَفَلَا تَعْقِلُونَۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22629,
          "number": 139,
          "surah": "37",
          "page_number": 451,
          "text": "وَإِنَّ يُونُسَ لَمِنَ اَ۬لْمُرْسَلِينَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22630,
          "number": 140,
          "surah": "37",
          "page_number": 451,
          "text": "إِذَ اَبَقَ إِلَي اَ۬لْفُلْكِ اِ۬لْمَشْحُونِ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22631,
          "number": 141,
          "surah": "37",
          "page_number": 451,
          "text": "فَسَاهَمَ فَكَانَ مِنَ اَ۬لْمُدْحَضِينَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22632,
          "number": 142,
          "surah": "37",
          "page_number": 451,
          "text": "فَالْتَقَمَهُ اُ۬لْحُوتُ وَهُوَ مُلِيمٞۖ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22633,
          "number": 143,
          "surah": "37",
          "page_number": 451,
          "text": "فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ اَ۬لْمُسَبِّحِينَ",
          "juz": 23,
          "hizb": 45
        },
        {
          "id": 22634,
          "number": 144,
          "surah": "37",
          "page_number": 451,
          "text": "لَلَبِثَ فِے بَطْنِهِۦٓ إِلَيٰ يَوْمِ يُبْعَثُونَۖ",
          "juz": 23,
          "hizb": 45
        }
      ]
    }
  ]
}