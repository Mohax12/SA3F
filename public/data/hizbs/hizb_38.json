          "surah": "27",
          "page_number": 380,
          "text": "قِيلَ لَهَا اَ۟دْخُلِے اِ۬لصَّرْحَۖ فَلَمَّا رَأَتْهُ حَسِبَتْهُ لُجَّةٗ وَكَشَفَتْ عَن سَاقَيْهَاۖ قَالَ إِنَّهُۥ صَرْحٞ مُّمَرَّدٞ مِّن قَوَارِيرَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21907,
          "number": 46,
          "surah": "27",
          "page_number": 380,
          "text": "قَالَتْ رَبِّ إِنِّے ظَلَمْتُ نَفْسِے وَأَسْلَمْتُ مَعَ سُلَيْمَٰنَ لِلهِ رَبِّ اِ۬لْعَٰلَمِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21908,
          "number": 47,
          "surah": "27",
          "page_number": 381,
          "text": "وَلَقَدَ اَرْسَلْنَآ إِلَيٰ ثَمُودَ أَخَاهُمْ صَٰلِحاً اَنُ اُ۟عْبُدُواْ اُ۬للَّهَ فَإِذَا هُمْ فَرِيقَٰنِ يَخْتَصِمُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21909,
          "number": 48,
          "surah": "27",
          "page_number": 381,
          "text": "قَالَ يَٰقَوْمِ لِمَ تَسْتَعْجِلُونَ بِالسَّيِّيـَٔةِ قَبْلَ اَ۬لْحَسَنَةِ لَوْلَا تَسْتَغْفِرُونَ اَ۬للَّهَ لَعَلَّكُمْ تُرْحَمُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21910,
          "number": 49,
          "surah": "27",
          "page_number": 381,
          "text": "قَالُواْ اُ۪طَّيَّرْنَا بِكَ وَبِمَن مَّعَكَۖ قَالَ طَٰٓئِرُكُمْ عِندَ اَ۬للَّهِۖ بَلَ اَنتُمْ قَوْمٞ تُفْتَنُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21911,
          "number": 50,
          "surah": "27",
          "page_number": 381,
          "text": "وَكَانَ فِے اِ۬لْمَدِينَةِ تِسْعَةُ رَهْطٖ يُفْسِدُونَ فِے اِ۬لَارْضِ وَلَا يُصْلِحُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21912,
          "number": 51,
          "surah": "27",
          "page_number": 381,
          "text": "قَالُواْ تَقَاسَمُواْ بِاللَّهِ لَنُبَيِّتَنَّهُۥ وَأَهْلَهُۥ ثُمَّ لَنَقُولَنَّ لِوَلِيِّهِۦ مَا شَهِدْنَا مُهْلَكَ أَهْلِهِۦ وَإِنَّا لَصَٰدِقُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21913,
          "number": 52,
          "surah": "27",
          "page_number": 381,
          "text": "وَمَكَرُواْ مَكْراٗ وَمَكَرْنَا مَكْراٗ وَهُمْ لَا يَشْعُرُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21914,
          "number": 53,
          "surah": "27",
          "page_number": 381,
          "text": "فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ مَكْرِهِمُۥٓۖ إِنَّا دَمَّرْنَٰهُمْ وَقَوْمَهُمُۥٓ أَجْمَعِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21915,
          "number": 54,
          "surah": "27",
          "page_number": 381,
          "text": "فَتِلْكَ بُيُوتُهُمْ خَاوِيَةَۢ بِمَا ظَلَمُوٓاْۖ إِنَّ فِے ذَٰلِكَ لَأٓيَةٗ لِّقَوْمٖ يَعْلَمُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21916,
          "number": 55,
          "surah": "27",
          "page_number": 381,
          "text": "وَأَنجَيْنَا اَ۬لذِينَ ءَامَنُواْ وَكَانُواْ يَتَّقُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21917,
          "number": 56,
          "surah": "27",
          "page_number": 381,
          "text": "وَلُوطاً اِذْ قَالَ لِقَوْمِهِۦٓ أَتَاتُونَ اَ۬لْفَٰحِشَةَ وَأَنتُمْ تُبْصِرُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21918,
          "number": 57,
          "surah": "27",
          "page_number": 381,
          "text": "أَئِنَّكُمْ لَتَاتُونَ اَ۬لرِّجَالَ شَهْوَةٗ مِّن دُونِ اِ۬لنِّسَآءِۖ بَلَ اَنتُمْ قَوْمٞ تَجْهَلُونَۖ",
          "juz": 19,
          "hizb": 38
        }
      ]
    }
  ]
