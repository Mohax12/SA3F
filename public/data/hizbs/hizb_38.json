          "hizb": 38
        },
        {
          "id": 21868,
          "number": 7,
          "surah": "27",
          "page_number": 377,
          "text": "اِذْ قَالَ مُوس۪يٰ لِأَهْلِهِۦٓ إِنِّيَ ءَانَسْتُ نَاراٗ سَــَٔاتِيكُم مِّنْهَا بِخَبَرٍ اَوَ اٰتِيكُم بِشِهَابِ قَبَسٖ لَّعَلَّكُمْ تَصْطَلُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21869,
          "number": 8,
          "surah": "27",
          "page_number": 377,
          "text": "فَلَمَّا جَآءَهَا نُودِيَ أَنۢ بُورِكَ مَن فِے اِ۬لنّ۪ارِ وَمَنْ حَوْلَهَا وَسُبْحَٰنَ اَ۬للَّهِ رَبِّ اِ۬لْعَٰلَمِينَۖ",
