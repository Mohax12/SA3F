        },
        {
          "id": 21901,
          "number": 40,
          "surah": "27",
          "page_number": 380,
          "text": "قَالَ عِفْرِيتٞ مِّنَ اَ۬لْجِنِّ أَنَآ ءَاتِيكَ بِهِۦ قَبْلَ أَن تَقُومَ مِن مَّقَامِكَۖ وَإِنِّے عَلَيْهِ لَقَوِيٌّ اَمِينٞۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21902,
          "number": 41,
          "surah": "27",
          "page_number": 380,
          "text": "قَالَ اَ۬لذِے عِندَهُۥ عِلْمٞ مِّنَ اَ۬لْكِتَٰبِ أَنَآ ءَاتِيكَ بِهِۦ قَبْلَ أَنْ يَّرْتَدَّ إِلَيْكَ طَرْفُكَۖ فَلَمَّا ر۪ء۪اهُ مُسْتَقِرّاً عِندَهُۥ قَالَ هَٰذَا مِن فَضْلِ رَبِّے لِيَبْلُوَنِيَ ءَآشْكُرُ أَمَ اَكْفُرُۖ وَمَن شَكَرَ فَإِنَّمَا يَشْكُرُ لِنَفْسِهِۦۖ وَمَن كَفَرَ فَإِنَّ رَبِّے غَنِيّٞ كَرِيمٞۖ",
