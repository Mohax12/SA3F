          "hizb": 38
        },
        {
          "id": 21875,
          "number": 14,
          "surah": "27",
          "page_number": 378,
          "text": "وَجَحَدُواْ بِهَا وَاسْتَيْقَنَتْهَآ أَنفُسُهُمْ ظُلْماٗ وَعُلُوّاٗۖ فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُفْسِدِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21876,
          "number": 15,
          "surah": "27",
          "page_number": 378,
          "text": "وَلَقَدَ اٰتَيْنَا دَاوُۥدَ وَسُلَيْمَٰنَ عِلْماٗ وَقَالَا اَ۬لْحَمْدُ لِلهِ اِ۬لذِے فَضَّلَنَا عَلَيٰ كَثِيرٖ مِّنْ عِبَادِهِ اِ۬لْمُومِنِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21877,
          "number": 16,
          "surah": "27",
          "page_number": 378,
          "text": "وَوَرِثَ سُلَيْمَٰنُ دَاوُۥدَ وَقَالَ يَٰٓأَيُّهَا اَ۬لنَّاسُ عُلِّمْنَا مَنطِقَ اَ۬لطَّيْرِ وَأُوتِينَا مِن كُلِّ شَےْءٍۖ اِنَّ هَٰذَا لَهُوَ اَ۬لْفَضْلُ اُ۬لْمُبِينُۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21878,
          "number": 17,
          "surah": "27",
          "page_number": 378,
