          "hizb": 38
        },
        {
          "id": 21870,
          "number": 9,
          "surah": "27",
          "page_number": 377,
          "text": "يَٰمُوس۪يٰٓ إِنَّهُۥٓ أَنَا اَ۬للَّهُ اُ۬لْعَزِيزُ اُ۬لْحَكِيمُ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21871,
          "number": 10,
          "surah": "27",
          "page_number": 377,
          "text": "وَأَلْقِ عَصَاكَۖ فَلَمَّا ر۪ء۪اهَا تَهْتَزُّ كَأَنَّهَا جَآنّٞ وَلّ۪يٰ مُدْبِراٗ وَلَمْ يُعَقِّبْۖ يَٰمُوس۪يٰ لَا تَخَفِۖ اِنِّے لَا يَخَافُ لَدَيَّ اَ۬لْمُرْسَلُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21872,
          "number": 11,
          "surah": "27",
          "page_number": 377,
          "text": "إِلَّا مَن ظَلَمَ ثُمَّ بَدَّلَ حُسْناَۢ بَعْدَ سُوٓءٖ فَإِنِّے غَفُورٞ رَّحِيمٞۖ",
