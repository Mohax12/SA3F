          "number": 1,
          "surah": "27",
          "page_number": 377,
          "text": "طَسِٓۖ تِلْكَ ءَايَٰتُ اُ۬لْقُرْءَانِ وَكِتَابٖ مُّبِينٍۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21863,
          "number": 2,
          "surah": "27",
          "page_number": 377,
          "text": "هُديٗ وَبُشْر۪يٰ لِلْمُومِنِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21864,
          "number": 3,
          "surah": "27",
          "page_number": 377,
          "text": "اَ۬لذِينَ يُقِيمُونَ اَ۬لصَّلَوٰةَ وَيُوتُونَ اَ۬لزَّكَوٰةَ وَهُم بِالَاخِرَةِ هُمْ يُوقِنُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21865,
          "number": 4,
          "surah": "27",
          "page_number": 377,
          "text": "إِنَّ اَ۬لذِينَ لَا يُومِنُونَ بِالَاخِرَةِ زَيَّنَّا لَهُمُۥٓ أَعْمَٰلَهُمْ فَهُمْ يَعْمَهُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21866,
          "number": 5,
          "surah": "27",
          "page_number": 377,
          "text": "أُوْلَٰٓئِكَ اَ۬لذِينَ لَهُمْ سُوٓءُ اُ۬لْعَذَابِ وَهُمْ فِے اِ۬لَاخِرَةِ هُمُ اُ۬لَاخْسَرُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21867,
          "number": 6,
          "surah": "27",
          "page_number": 377,
          "text": "۞وَإِنَّكَ لَتُلَقَّي اَ۬لْقُرْءَانَ مِن لَّدُنْ حَكِيمٍ عَلِيمٍۖ",
