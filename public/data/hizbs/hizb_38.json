{
  "mushaf_id": 4,
  "mushaf_name": "مصحف ورش",
  "hizb": 38,
  "surahs": [
    {
      "id": 26,
      "name": "سورة الشعراء",
      "coded_name": "ﮦ",
      "ayahs": [
        {
          "id": 21746,
          "number": 111,
          "surah": "26",
          "page_number": 371,
          "text": "۞قَالُوٓاْ أَنُومِنُ لَكَ وَاتَّبَعَكَ اَ۬لَارْذَلُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21747,
          "number": 112,
          "surah": "26",
          "page_number": 372,
          "text": "قَالَ وَمَا عِلْمِے بِمَا كَانُواْ يَعْمَلُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21748,
          "number": 113,
          "surah": "26",
          "page_number": 372,
          "text": "إِنْ حِسَابُهُمُۥٓ إِلَّا عَلَيٰ رَبِّے لَوْ تَشْعُرُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21749,
          "number": 114,
          "surah": "26",
          "page_number": 372,
          "text": "وَمَآ أَنَا بِطَارِدِ اِ۬لْمُومِنِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21750,
          "number": 115,
          "surah": "26",
          "page_number": 372,
          "text": "إِنَ اَنَا إِلَّا نَذِيرٞ مُّبِينٞۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21751,
          "number": 116,
          "surah": "26",
          "page_number": 372,
          "text": "قَالُواْ لَئِن لَّمْ تَنتَهِ يَٰنُوحُ لَتَكُونَنَّ مِنَ اَ۬لْمَرْجُومِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21752,
          "number": 117,
          "surah": "26",
          "page_number": 372,
          "text": "قَالَ رَبِّ إِنَّ قَوْمِے كَذَّبُونِ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21753,
          "number": 118,
          "surah": "26",
          "page_number": 372,
          "text": "فَافْتَحْ بَيْنِے وَبَيْنَهُمْ فَتْحاٗ وَنَجِّنِے وَمَن مَّعِيَ مِنَ اَ۬لْمُومِنِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21754,
          "number": 119,
          "surah": "26",
          "page_number": 372,
          "text": "فَأَنجَيْنَٰهُ وَمَن مَّعَهُۥ فِے اِ۬لْفُلْكِ اِ۬لْمَشْحُونِۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21755,
          "number": 120,
          "surah": "26",
          "page_number": 372,
          "text": "ثُمَّ أَغْرَقْنَا بَعْدُ اُ۬لْبَاقِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21756,
          "number": 121,
          "surah": "26",
          "page_number": 372,
          "text": "إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّومِنِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21757,
          "number": 122,
          "surah": "26",
          "page_number": 372,
          "text": "وَإِنَّ رَبَّكَ لَهُوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21758,
          "number": 123,
          "surah": "26",
          "page_number": 372,
          "text": "كَذَّبَتْ عَادٌ اِ۬لْمُرْسَلِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21759,
          "number": 124,
          "surah": "26",
          "page_number": 372,
          "text": "إِذْ قَالَ لَهُمُۥٓ أَخُوهُمْ هُودٌ اَلَا تَتَّقُونَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21760,
          "number": 125,
          "surah": "26",
          "page_number": 372,
          "text": "إِنِّے لَكُمْ رَسُولٌ اَمِينٞۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21761,
          "number": 126,
          "surah": "26",
          "page_number": 372,
          "text": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21762,
          "number": 127,
          "surah": "26",
          "page_number": 372,
          "text": "وَمَآ أَسْــَٔلُكُمْ عَلَيْهِ مِنَ اَجْرٍۖ اِنَ اَجْرِيَ إِلَّا عَلَيٰ رَبِّ اِ۬لْعَٰلَمِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21763,
          "number": 128,
          "surah": "26",
          "page_number": 372,
          "text": "أَتَبْنُونَ بِكُلِّ رِيعٍ اٰيَةٗ تَعْبَثُونَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21764,
          "number": 129,
          "surah": "26",
          "page_number": 372,
          "text": "وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمْ تَخْلُدُونَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21765,
          "number": 130,
          "surah": "26",
          "page_number": 372,
          "text": "وَإِذَا بَطَشْتُم بَطَشْتُمْ جَبّ۪ارِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21766,
          "number": 131,
          "surah": "26",
          "page_number": 372,
          "text": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21767,
          "number": 132,
          "surah": "26",
          "page_number": 372,
          "text": "وَاتَّقُواْ اُ۬لذِےٓ أَمَدَّكُم بِمَا تَعْلَمُونَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21768,
          "number": 133,
          "surah": "26",
          "page_number": 372,
          "text": "أَمَدَّكُم بِأَنْعَٰمٖ وَبَنِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21769,
          "number": 134,
          "surah": "26",
          "page_number": 372,
          "text": "وَجَنَّٰتٖ وَعُيُونٍۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21770,
          "number": 135,
          "surah": "26",
          "page_number": 372,
          "text": "اِنِّيَ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٖۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21771,
          "number": 136,
          "surah": "26",
          "page_number": 372,
          "text": "قَالُواْ سَوَآءٌ عَلَيْنَآ أَوَعَظْتَ أَمْ لَمْ تَكُن مِّنَ اَ۬لْوَٰعِظِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21772,
          "number": 137,
          "surah": "26",
          "page_number": 373,
          "text": "إِنْ هَٰذَآ إِلَّا خُلُقُ اُ۬لَاوَّلِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21773,
          "number": 138,
          "surah": "26",
          "page_number": 373,
          "text": "وَمَا نَحْنُ بِمُعَذَّبِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21774,
          "number": 139,
          "surah": "26",
          "page_number": 373,
          "text": "فَكَذَّبُوهُ فَأَهْلَكْنَٰهُمُۥٓۖ إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّومِنِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21775,
          "number": 140,
          "surah": "26",
          "page_number": 373,
          "text": "وَإِنَّ رَبَّكَ لَهُوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21776,
          "number": 141,
          "surah": "26",
          "page_number": 373,
          "text": "كَذَّبَتْ ثَمُودُ اُ۬لْمُرْسَلِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21777,
          "number": 142,
          "surah": "26",
          "page_number": 373,
          "text": "إِذْ قَالَ لَهُمُۥٓ أَخُوهُمْ صَٰلِحٌ اَلَا تَتَّقُونَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21778,
          "number": 143,
          "surah": "26",
          "page_number": 373,
          "text": "إِنِّے لَكُمْ رَسُولٌ اَمِينٞۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21779,
          "number": 144,
          "surah": "26",
          "page_number": 373,
          "text": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21780,
          "number": 145,
          "surah": "26",
          "page_number": 373,
          "text": "وَمَآ أَسْــَٔلُكُمْ عَلَيْهِ مِنَ اَجْرٍۖ اِنَ اَجْرِيَ إِلَّا عَلَيٰ رَبِّ اِ۬لْعَٰلَمِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21781,
          "number": 146,
          "surah": "26",
          "page_number": 373,
          "text": "۞أَتُتْرَكُونَ فِے مَا هَٰهُنَآ ءَامِنِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21782,
          "number": 147,
          "surah": "26",
          "page_number": 373,
          "text": "فِے جَنَّٰتٖ وَعُيُونٖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21783,
          "number": 148,
          "surah": "26",
          "page_number": 373,
          "text": "وَزُرُوعٖ وَنَخْلٖ طَلْعُهَا هَضِيمٞ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21784,
          "number": 149,
          "surah": "26",
          "page_number": 373,
          "text": "وَتَنْحِتُونَ مِنَ اَ۬لْجِبَالِ بُيُوتاٗ فَرِهِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21785,
          "number": 150,
          "surah": "26",
          "page_number": 373,
          "text": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21786,
          "number": 151,
          "surah": "26",
          "page_number": 373,
          "text": "وَلَا تُطِيعُوٓاْ أَمْرَ اَ۬لْمُسْرِفِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21787,
          "number": 152,
          "surah": "26",
          "page_number": 373,
          "text": "اَ۬لذِينَ يُفْسِدُونَ فِے اِ۬لَارْضِ وَلَا يُصْلِحُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21788,
          "number": 153,
          "surah": "26",
          "page_number": 373,
          "text": "قَالُوٓاْ إِنَّمَآ أَنتَ مِنَ اَ۬لْمُسَحَّرِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21789,
          "number": 154,
          "surah": "26",
          "page_number": 373,
          "text": "مَآ أَنتَ إِلَّا بَشَرٞ مِّثْلُنَا فَاتِ بِــَٔايَةٍ اِن كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21790,
          "number": 155,
          "surah": "26",
          "page_number": 373,
          "text": "قَالَ هَٰذِهِۦ نَاقَةٞ لَّهَا شِرْبٞ وَلَكُمْ شِرْبُ يَوْمٖ مَّعْلُومٖۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21791,
          "number": 156,
          "surah": "26",
          "page_number": 373,
          "text": "وَلَا تَمَسُّوهَا بِسُوٓءٖ فَيَاخُذَكُمْ عَذَابُ يَوْمٍ عَظِيمٖۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21792,
          "number": 157,
          "surah": "26",
          "page_number": 373,
          "text": "فَعَقَرُوهَا فَأَصْبَحُواْ نَٰدِمِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21793,
          "number": 158,
          "surah": "26",
          "page_number": 373,
          "text": "فَأَخَذَهُمُ اُ۬لْعَذَابُۖ إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّومِنِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21794,
          "number": 159,
          "surah": "26",
          "page_number": 373,
          "text": "وَإِنَّ رَبَّكَ لَهُوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21795,
          "number": 160,
          "surah": "26",
          "page_number": 374,
          "text": "كَذَّبَتْ قَوْمُ لُوطٍ اِ۬لْمُرْسَلِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21796,
          "number": 161,
          "surah": "26",
          "page_number": 374,
          "text": "إِذْ قَالَ لَهُمُۥٓ أَخُوهُمْ لُوطٌ اَلَا تَتَّقُونَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21797,
          "number": 162,
          "surah": "26",
          "page_number": 374,
          "text": "إِنِّے لَكُمْ رَسُولٌ اَمِينٞۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21798,
          "number": 163,
          "surah": "26",
          "page_number": 374,
          "text": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21799,
          "number": 164,
          "surah": "26",
          "page_number": 374,
          "text": "وَمَآ أَسْــَٔلُكُمْ عَلَيْهِ مِنَ اَجْرٍۖ اِنَ اَجْرِيَ إِلَّا عَلَيٰ رَبِّ اِ۬لْعَٰلَمِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21800,
          "number": 165,
          "surah": "26",
          "page_number": 374,
          "text": "أَتَاتُونَ اَ۬لذُّكْرَانَ مِنَ اَ۬لْعَٰلَمِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21801,
          "number": 166,
          "surah": "26",
          "page_number": 374,
          "text": "وَتَذَرُونَ مَا خَلَقَ لَكُمْ رَبُّكُم مِّنَ اَزْوَٰجِكُمۖ بَلَ اَنتُمْ قَوْمٌ عَادُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21802,
          "number": 167,
          "surah": "26",
          "page_number": 374,
          "text": "قَالُواْ لَئِن لَّمْ تَنتَهِ يَٰلُوطُ لَتَكُونَنَّ مِنَ اَ۬لْمُخْرَجِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21803,
          "number": 168,
          "surah": "26",
          "page_number": 374,
          "text": "قَالَ إِنِّے لِعَمَلِكُم مِّنَ اَ۬لْقَالِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21804,
          "number": 169,
          "surah": "26",
          "page_number": 374,
          "text": "رَبِّ نَجِّنِے وَأَهْلِے مِمَّا يَعْمَلُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21805,
          "number": 170,
          "surah": "26",
          "page_number": 374,
          "text": "فَنَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21806,
          "number": 171,
          "surah": "26",
          "page_number": 374,
          "text": "إِلَّا عَجُوزاٗ فِے اِ۬لْغَٰبِرِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21807,
          "number": 172,
          "surah": "26",
          "page_number": 374,
          "text": "ثُمَّ دَمَّرْنَا اَ۬لَاخَرِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21808,
          "number": 173,
          "surah": "26",
          "page_number": 374,
          "text": "وَأَمْطَرْنَا عَلَيْهِم مَّطَراٗۖ فَسَآءَ مَطَرُ اُ۬لْمُنذَرِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21809,
          "number": 174,
          "surah": "26",
          "page_number": 374,
          "text": "إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّومِنِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21810,
          "number": 175,
          "surah": "26",
          "page_number": 374,
          "text": "وَإِنَّ رَبَّكَ لَهُوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21811,
          "number": 176,
          "surah": "26",
          "page_number": 374,
          "text": "كَذَّبَ أَصْحَٰبُ لَيْكَةَ اَ۬لْمُرْسَلِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21812,
          "number": 177,
          "surah": "26",
          "page_number": 374,
          "text": "إِذْ قَالَ لَهُمْ شُعَيْبٌ اَلَا تَتَّقُونَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21813,
          "number": 178,
          "surah": "26",
          "page_number": 374,
          "text": "إِنِّے لَكُمْ رَسُولٌ اَمِينٞۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21814,
          "number": 179,
          "surah": "26",
          "page_number": 374,
          "text": "فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21815,
          "number": 180,
          "surah": "26",
          "page_number": 374,
          "text": "وَمَآ أَسْــَٔلُكُمْ عَلَيْهِ مِنَ اَجْرٍۖ اِنَ اَجْرِيَ إِلَّا عَلَيٰ رَبِّ اِ۬لْعَٰلَمِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21816,
          "number": 181,
          "surah": "26",
          "page_number": 374,
          "text": "۞أَوْفُواْ اُ۬لْكَيْلَ وَلَا تَكُونُواْ مِنَ اَ۬لْمُخْسِرِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21817,
          "number": 182,
          "surah": "26",
          "page_number": 374,
          "text": "وَزِنُواْ بِالْقُسْطَاسِ اِ۬لْمُسْتَقِيمِۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21818,
          "number": 183,
          "surah": "26",
          "page_number": 374,
          "text": "وَلَا تَبْخَسُواْ اُ۬لنَّاسَ أَشْيَآءَهُمْ وَلَا تَعْثَوْاْ فِے اِ۬لَارْضِ مُفْسِدِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21819,
          "number": 184,
          "surah": "26",
          "page_number": 375,
          "text": "وَاتَّقُواْ اُ۬لذِے خَلَقَكُمْ وَالْجِبِلَّةَ اَ۬لَاوَّلِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21820,
          "number": 185,
          "surah": "26",
          "page_number": 375,
          "text": "قَالُوٓاْ إِنَّمَآ أَنتَ مِنَ اَ۬لْمُسَحَّرِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21821,
          "number": 186,
          "surah": "26",
          "page_number": 375,
          "text": "وَمَآ أَنتَ إِلَّا بَشَرٞ مِّثْلُنَا وَإِن نَّظُنُّكَ لَمِنَ اَ۬لْكَٰذِبِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21822,
          "number": 187,
          "surah": "26",
          "page_number": 375,
          "text": "فَأَسْقِطْ عَلَيْنَا كِسْفاٗ مِّنَ اَ۬لسَّمَآءِ ان كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21823,
          "number": 188,
          "surah": "26",
          "page_number": 375,
          "text": "قَالَ رَبِّيَ أَعْلَمُ بِمَا تَعْمَلُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21824,
          "number": 189,
          "surah": "26",
          "page_number": 375,
          "text": "فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ اِ۬لظُّلَّةِۖ إِنَّهُۥ كَانَ عَذَابَ يَوْمٍ عَظِيمٍۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21825,
          "number": 190,
          "surah": "26",
          "page_number": 375,
          "text": "اِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّومِنِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21826,
          "number": 191,
          "surah": "26",
          "page_number": 375,
          "text": "وَإِنَّ رَبَّكَ لَهُوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21827,
          "number": 192,
          "surah": "26",
          "page_number": 375,
          "text": "وَإِنَّهُۥ لَتَنزِيلُ رَبِّ اِ۬لْعَٰلَمِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21828,
          "number": 193,
          "surah": "26",
          "page_number": 375,
          "text": "نَزَلَ بِهِ اِ۬لرُّوحُ اُ۬لَامِينُ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21829,
          "number": 194,
          "surah": "26",
          "page_number": 375,
          "text": "عَلَيٰ قَلْبِكَ لِتَكُونَ مِنَ اَ۬لْمُنذِرِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21830,
          "number": 195,
          "surah": "26",
          "page_number": 375,
          "text": "بِلِسَانٍ عَرَبِيّٖ مُّبِينٖۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21831,
          "number": 196,
          "surah": "26",
          "page_number": 375,
          "text": "وَإِنَّهُۥ لَفِے زُبُرِ اِ۬لَاوَّلِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21832,
          "number": 197,
          "surah": "26",
          "page_number": 375,
          "text": "أَوَلَمْ يَكُن لَّهُمُۥٓ ءَايَةً اَنْ يَّعْلَمَهُۥ عُلَمَٰٓؤُاْ بَنِےٓ إِسْرَآءِيلَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21833,
          "number": 198,
          "surah": "26",
          "page_number": 375,
          "text": "وَلَوْ نَزَّلْنَٰهُ عَلَيٰ بَعْضِ اِ۬لَاعْجَمِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21834,
          "number": 199,
          "surah": "26",
          "page_number": 375,
          "text": "فَقَرَأَهُۥ عَلَيْهِم مَّا كَانُواْ بِهِۦ مُومِنِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21835,
          "number": 200,
          "surah": "26",
          "page_number": 375,
          "text": "كَذَٰلِكَ سَلَكْنَٰهُ فِے قُلُوبِ اِ۬لْمُجْرِمِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21836,
          "number": 201,
          "surah": "26",
          "page_number": 375,
          "text": "لَا يُومِنُونَ بِهِۦ حَتَّيٰ يَرَوُاْ اُ۬لْعَذَابَ اَ۬لَالِيمَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21837,
          "number": 202,
          "surah": "26",
          "page_number": 375,
          "text": "فَيَاتِيَهُم بَغْتَةٗ وَهُمْ لَا يَشْعُرُونَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21838,
          "number": 203,
          "surah": "26",
          "page_number": 375,
          "text": "فَيَقُولُواْ هَلْ نَحْنُ مُنظَرُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21839,
          "number": 204,
          "surah": "26",
          "page_number": 375,
          "text": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21840,
          "number": 205,
          "surah": "26",
          "page_number": 375,
          "text": "أَفَرَٰٓيْتَ إِن مَّتَّعْنَٰهُمْ سِنِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21841,
          "number": 206,
          "surah": "26",
          "page_number": 375,
          "text": "ثُمَّ جَآءَهُم مَّا كَانُواْ يُوعَدُونَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21842,
          "number": 207,
          "surah": "26",
          "page_number": 376,
          "text": "مَآ أَغْن۪يٰ عَنْهُم مَّا كَانُواْ يُمَتَّعُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21843,
          "number": 208,
          "surah": "26",
          "page_number": 376,
          "text": "وَمَآ أَهْلَكْنَا مِن قَرْيَةٍ اِلَّا لَهَا مُنذِرُونَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21844,
          "number": 209,
          "surah": "26",
          "page_number": 376,
          "text": "ذِكْر۪يٰۖ وَمَا كُنَّا ظَٰلِمِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21845,
          "number": 210,
          "surah": "26",
          "page_number": 376,
          "text": "۞وَمَا تَنَزَّلَتْ بِهِ اِ۬لشَّيَٰطِينُ وَمَا يَنۢبَغِے لَهُمْ وَمَا يَسْتَطِيعُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21846,
          "number": 211,
          "surah": "26",
          "page_number": 376,
          "text": "إِنَّهُمْ عَنِ اِ۬لسَّمْعِ لَمَعْزُولُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21847,
          "number": 212,
          "surah": "26",
          "page_number": 376,
          "text": "فَلَا تَدْعُ مَعَ اَ۬للَّهِ إِلَٰهاً اٰخَرَ فَتَكُونَ مِنَ اَ۬لْمُعَذَّبِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21848,
          "number": 213,
          "surah": "26",
          "page_number": 376,
          "text": "وَأَنذِرْ عَشِيرَتَكَ اَ۬لَاقْرَبِينَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21849,
          "number": 214,
          "surah": "26",
          "page_number": 376,
          "text": "وَاخْفِضْ جَنَاحَكَ لِمَنِ اِ۪تَّبَعَكَ مِنَ اَ۬لْمُومِنِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21850,
          "number": 215,
          "surah": "26",
          "page_number": 376,
          "text": "فَإِنْ عَصَوْكَ فَقُلِ اِنِّے بَرِےٓءٞ مِّمَّا تَعْمَلُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21851,
          "number": 216,
          "surah": "26",
          "page_number": 376,
          "text": "فَتَوَكَّلْ عَلَي اَ۬لْعَزِيزِ اِ۬لرَّحِيمِ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21852,
          "number": 217,
          "surah": "26",
          "page_number": 376,
          "text": "اِ۬لذِے يَر۪يٰكَ حِينَ تَقُومُ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21853,
          "number": 218,
          "surah": "26",
          "page_number": 376,
          "text": "وَتَقَلُّبَكَ فِے اِ۬لسَّٰجِدِينَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21854,
          "number": 219,
          "surah": "26",
          "page_number": 376,
          "text": "إِنَّهُۥ هُوَ اَ۬لسَّمِيعُ اُ۬لْعَلِيمُۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21855,
          "number": 220,
          "surah": "26",
          "page_number": 376,
          "text": "هَلُ ا۟نَبِّيـُٔكُمْ عَلَيٰ مَن تَنَزَّلُ اُ۬لشَّيَٰطِينُ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21856,
          "number": 221,
          "surah": "26",
          "page_number": 376,
          "text": "تَنَزَّلُ عَلَيٰ كُلِّ أَفَّاكٍ اَثِيمٖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21857,
          "number": 222,
          "surah": "26",
          "page_number": 376,
          "text": "يُلْقُونَ اَ۬لسَّمْعَ وَأَكْثَرُهُمْ كَٰذِبُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21858,
          "number": 223,
          "surah": "26",
          "page_number": 376,
          "text": "وَالشُّعَرَآءُ يَتْبَعُهُمُ اُ۬لْغَاوُۥنَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21859,
          "number": 224,
          "surah": "26",
          "page_number": 376,
          "text": "أَلَمْ تَرَ أَنَّهُمْ فِے كُلِّ وَادٖ يَهِيمُونَ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21860,
          "number": 225,
          "surah": "26",
          "page_number": 376,
          "text": "وَأَنَّهُمْ يَقُولُونَ مَا لَا يَفْعَلُونَۖ",
          "juz": 19,
          "hizb": 38
        },
        {
          "id": 21861,
          "number": 226,
          "surah": "26",
          "page_number": 376,
          "text": "إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ وَذَكَرُواْ اُ۬للَّهَ كَثِيراٗ وَانتَصَرُواْ مِنۢ بَعْدِ مَا ظُلِمُواْۖ وَسَيَعْلَمُ اُ۬لذِينَ ظَلَمُوٓاْ أَيَّ مُنقَلَبٖ يَنقَلِبُونَۖ",
          "juz": 19,
          "hizb": 38
        }
      ]
    },
    {
      "id": 27,
